        for side in ("top", "bottom", "start", "end"):
            getattr(bar, "set_margin_" + side)(12)
        for wdg in (self.status, cancel, self.save):
            bar.append(wdg)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(scroll)
        outer.append(Gtk.Separator())
        outer.append(bar)
        self.set_child(outer)
        self.update()

    def pick(self, index, value):
        self.answers[index] = value
        self.update()

    def pick_difficulty(self, value):
        self.difficulty = value

    def update(self):
        left = sum(a is None for a in self.answers)
        self.diff_box.set_visible(any(a for a in self.answers if a))
        self.save.set_sensitive(left == 0)
        self.status.set_text(trn("%d question left", "%d questions left", left) % left if left
                             else tr("Score: %d of %d") % (sum(self.answers), survey_max(self.kind)))

    def on_save(self, *_):
        if any(a is None for a in self.answers):
            return
        win = self.win
        diff = self.difficulty if any(self.answers) else -1
        survey = win.surveys.add(self.kind, self.answers, diff,
                                 private=self.private_check.get_active() and win.prefs["private_tick"])
        if not win.save_surveys():
            self.status.set_text(tr("Could not save to surveys.json."))
            return
        self.close()
        if survey_worries(survey):
            SurveyCareWindow(win).present()


