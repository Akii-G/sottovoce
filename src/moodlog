    def refresh_appointment(self):
        for window in self.list_toplevels_of(AppointmentWindow):
            window.update()
        if hasattr(self, "appt_row"):
            appt = self.appointment.appt
            self.appt_row_text.set_text(appointment_when(appt) if appt["date"]
                                        else tr("No appointment set"))
        if not hasattr(self, "appt_card"):
            return
        shown = self.appointment.card_shown()
        self.appt_card.set_visible(shown)
        if not shown:
            return
        appt, today = self.appointment.appt, dt.date.today()
        self.appt_title.set_text(tr("Your appointment") + " · " + appointment_when(appt, today))
        self.appt_recap.set_text(appointment_recap(self.store, self.events,
                                                   self.appointment.recap_start(today), today))
        n = len(self.appointment.open_points())
        self.appt_points.set_text(trn("%d thing to talk about", "%d things to talk about", n) % n if n
                                  else tr("Anything you want to remember to say? Add it here."))

    def list_toplevels_of(self, cls):
        return [w for w in Gtk.Window.list_toplevels() if isinstance(w, cls)]

    def save_appointment(self):
        try:
            self.appointment.save()
