def stores_from_json(doc):
    """Moods and events sent by the iPhone app -> (Store, EventStore), checked field by field."""
    store, events = Store(""), EventStore("")
    if not isinstance(doc, dict):
        return store, events

    def day_of(value):
        try:
            return dt.date.fromisoformat(str(value))
        except ValueError:
            return None

    def level(value):
        return value if isinstance(value, int) and not isinstance(value, bool) and 1 <= value <= 5 else 0

    for item in (doc.get("entries") or [])[:200000]:
        if not isinstance(item, dict):
            continue
        day, eid, stamp = day_of(item.get("date")), str(item.get("id") or "")[:64], clean_stamp(item.get("updated"))
        if not day or not eid or not stamp:
            continue
        time = str(item.get("time") or "")
        note = str(item.get("note") or "")[:20000]
        mood, energy, anxiety = level(item.get("mood")), level(item.get("energy")), level(item.get("anxiety"))
        feelings = clean_feelings(item.get("feelings") if isinstance(item.get("feelings"), (list, str)) else "")
        acts = clean_activities(item.get("activities") if isinstance(item.get("activities"), (list, str)) else "")
        if mood or energy or anxiety or note.strip() or feelings or acts:
            store.add(day, time, mood, note, energy, anxiety, eid=eid, updated=stamp,
                      private=item.get("private") is True, feelings=feelings, activities=acts)
    for item in (doc.get("events") or [])[:20000]:
        if not isinstance(item, dict):
            continue
        day, eid, stamp = day_of(item.get("date")), str(item.get("id") or "")[:64], clean_stamp(item.get("updated"))
        title = " ".join(str(item.get("title") or "").split())[:500]
        if not day or not eid or not stamp or not title:
            continue
        kind = item.get("kind") if item.get("kind") in EVENT_LABELS else "other"
        events.add(day, kind, title, str(item.get("note") or "")[:20000], eid=eid, updated=stamp)
    for item in (doc.get("deleted") or [])[:200000]:
        if not isinstance(item, dict):
            continue
        eid, gone = str(item.get("id") or "")[:64], clean_stamp(item.get("deleted"))
        if not eid or not gone:
            continue
        if item.get("type") == "event":
            events.deleted[eid] = max(gone, events.deleted.get(eid, ""))
        elif item.get("type") in ("dream", "survey", "point"):
            continue  # read by dreams_from_json, SurveyStore and AppointmentStore
        else:
            store.deleted[eid] = (gone, day_of(item.get("date")))
    return store, events


def dreams_from_json(doc):
    """Dreams sent by the iPhone app (1.2 and newer) -> DreamStore, checked field by field."""
    dreams = DreamStore("")
    if not isinstance(doc, dict):
        return dreams
    for item in (doc.get("dreams") or [])[:50000]:
        if not isinstance(item, dict):
            continue
        try:
            day = dt.date.fromisoformat(str(item.get("date")))
        except ValueError:
            continue
        eid, stamp = str(item.get("id") or "")[:64], clean_stamp(item.get("updated"))
        feeling = item.get("feeling") if item.get("feeling") in DREAM_FEELING_LABELS else ""
        tags = clean_tags(item.get("tags") if isinstance(item.get("tags"), (list, str)) else "")
        text_ = str(item.get("text") or "")[:50000]
        if eid and stamp and (feeling or tags or text_.strip()):
            dreams.add(day, feeling, tags, text_, eid=eid, updated=stamp,
                       private=item.get("private") is True)
    for item in (doc.get("deleted") or [])[:200000]:
        if isinstance(item, dict) and item.get("type") == "dream":
            eid, gone = str(item.get("id") or "")[:64], clean_stamp(item.get("deleted"))
            if eid and gone:
                dreams.deleted[eid] = max(gone, dreams.deleted.get(eid, ""))
    return dreams


def stores_to_json(store, events, dreams=None, surveys=None, appointment=None):
    entries = [dict({"id": e[5], "date": day.isoformat(), "time": e[0], "mood": e[1], "energy": e[3],
                     "anxiety": e[4], "note": e[2], "updated": e[6]},
                    **({"private": True} if is_private(e, 7) else {}),
                    **({"feelings": entry_feelings(e)} if entry_feelings(e) else {}),
                    **({"activities": entry_activities(e)} if entry_activities(e) else {}))
               for day in sorted(store.days) for e in store.days[day]]
    evs = [{"id": e[4], "date": e[0].isoformat(), "kind": e[1], "title": e[2], "note": e[3],
            "updated": e[5]} for e in events.items]
    deleted = [{"id": eid, "type": "entry", "deleted": gone,
                "date": day.isoformat() if day else None}
               for eid, (gone, day) in store.deleted.items()]
    deleted += [{"id": eid, "type": "event", "deleted": gone} for eid, gone in events.deleted.items()]
    doc = {"app": "Moodlog", "version": VERSION, "server_time": now_stamp(),
           "entries": entries, "events": evs, "deleted": deleted}
    if dreams is not None:
        doc["dreams"] = [dict({"id": d[4], "date": d[0].isoformat(), "feeling": d[1],
                               "tags": dream_tags(d), "text": d[3], "updated": d[5]},
                              **({"private": True} if is_private(d, 6) else {}))
                         for d in dreams.items]
        deleted += [{"id": eid, "type": "dream", "deleted": gone} for eid, gone in dreams.deleted.items()]
    if surveys is not None:
        part = surveys.to_json()
        doc["surveys"] = part["surveys"]
        deleted += part["deleted"]
    if appointment is not None:
        part = appointment.to_json()
        if "appointment" in part:
            doc["appointment"] = part["appointment"]
        doc["points"] = part["points"]
        deleted += part["deleted"]
    return doc


def sync_with_phone(body):
    """Merge what the phone sent into the data files and return the merged state."""
    try:
        doc = json.loads(body.decode("utf-8") if isinstance(body, (bytes, bytearray)) else body)
    except (ValueError, UnicodeDecodeError):
        raise ValueError(tr("The request is not valid JSON."))
    remote_store, remote_events = stores_from_json(doc)
    remote_dreams = dreams_from_json(doc)
    store, events, dreams, surveys = Store(), EventStore(), DreamStore(), SurveyStore()
    dose = DoseMedication()
    if import_dose_events(events, dose):
        events.save()
    appointment = AppointmentStore()
    changed = store.absorb(remote_store) + events.absorb(remote_events)
    dream_changes = dreams.absorb(remote_dreams)
    survey_changes = surveys.absorb_json(doc) if isinstance(doc, dict) else 0
    appointment_changes = appointment.absorb_json(doc) if isinstance(doc, dict) else 0
    if appointment_changes:
        appointment.save()
    if changed:
        store.save()
        events.save()
    if dream_changes:
        dreams.save()
    if survey_changes:
        surveys.save()
    corrections = Corrections()
    correction_changes = corrections.absorb_json(doc.get("corrections")) if isinstance(doc, dict) else 0
    if correction_changes:
        corrections.save()
        HealthStore()  # loading it drops the nights the phone deleted
    changed += dream_changes + survey_changes + appointment_changes + correction_changes
    state = stores_to_json(store, events, dreams, surveys, appointment)
    state["corrections"] = corrections.to_json()
    state["changed"] = changed
    if dose.medicines:
        state["dose"] = dose_to_json(dose)
    return state


def dose_to_json(dose):
    """Dose's medicines and doses for the phones' Sottovoce (their report and day), as
    {"medicines": [{name, archived, asNeeded}], "doses": [{date, time, status, amount, name}]}.
    "pending" is a scheduled dose nobody marked; the phone tells not taken from yet to take."""
    same = Corrections().renames()
    ingredient = {DoseMedication.title(m): (m.get("ingredient") or "") for m in dose.medicines}
    meds = {}
    for n, i in sorted(dose.meds.items()):
        shown, had = same.get(n, n), meds.get(same.get(n, n))
        meds[shown] = {"name": shown, "archived": i["archived"] and (had is None or had["archived"]),
                       "asNeeded": i["as_needed"], "ingredient": ingredient.get(n, "")}
    return {"medicines": list(meds.values()),
            "doses": [{"date": d[0].isoformat(), "time": d[1], "status": d[2], "amount": d[4],
                       "name": same.get(d[5], d[5])} for d in dose.doses]}


def sync_config():
    """Token and port for the phone sync receiver (created on first use)."""
    path = os.path.join(data_dir(), "sync.json")
    try:
        with open(path, encoding="utf-8") as f:
            cfg = json.load(f)
        if isinstance(cfg.get("token"), str) and len(cfg["token"]) >= 16:
            cfg.setdefault("port", SYNC_PORT)
            return cfg
    except (OSError, ValueError, AttributeError):
        pass
    cfg = {"token": secrets.token_urlsafe(18), "port": SYNC_PORT}
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f)
    return cfg


def sync_status_path():
    return os.path.join(data_dir(), "sync-last.txt")


def lan_address():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.0.2.1", 9))  # no packet is sent; just picks the LAN interface
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return None


# ----------------------------------------------------------------- encrypted sync
#
# Moodlog for iPhone 1.4+ encrypts everything it sends: AES-256-GCM with a key derived
# from the shared token (HKDF-SHA256), so the token itself never crosses the network.
# A message is JSON {"v": 1, "n": base64 nonce, "c": base64 ciphertext+tag}; the
# additional data binds it to its endpoint and direction, so a message can't be replayed
# as another kind of message.

SYNC_SALT, SYNC_INFO = b"moodlog-sync", b"moodlog sync v1"


def sync_key(token):
    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.kdf.hkdf import HKDF
    return HKDF(algorithm=hashes.SHA256(), length=32, salt=SYNC_SALT,
                info=SYNC_INFO).derive(token.encode("utf-8"))


def sync_aad(path, reply):
    return ("moodlog/v1 %s %s" % ("reply" if reply else "request", path)).encode("utf-8")


def seal(token, path, obj, reply=False):
    import base64
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    nonce = secrets.token_bytes(12)
    data = AESGCM(sync_key(token)).encrypt(nonce, json.dumps(obj, ensure_ascii=False).encode("utf-8"),
                                           sync_aad(path, reply))
    return json.dumps({"v": 1, "n": base64.b64encode(nonce).decode(),
                       "c": base64.b64encode(data).decode()}).encode("utf-8")


def unseal(token, path, body, reply=False):
    """The JSON inside an encrypted message; ValueError if it isn't one for this token."""
    import base64, binascii
    from cryptography.exceptions import InvalidTag
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    try:
        doc = json.loads(body)
        nonce, data = base64.b64decode(doc["n"]), base64.b64decode(doc["c"])
        if doc.get("v") != 1 or len(nonce) != 12:
            raise ValueError("unknown format")
        plain = AESGCM(sync_key(token)).decrypt(nonce, data, sync_aad(path, reply))
        return json.loads(plain)
    except (KeyError, TypeError, binascii.Error, InvalidTag, UnicodeDecodeError, ValueError,
            AttributeError) as err:
        raise ValueError("not readable with this token") from err


def crypto_available():
    try:
        import cryptography.hazmat.primitives.ciphers.aead  # noqa: F401
        return True
    except ImportError:
        return False


def store_health_lines(body):
    """Store health data sent as text or JSON (the Shortcut or the iPhone app).
    Returns (stored anything, message for the sender)."""
    text_body = body.decode("utf-8", "replace") if isinstance(body, (bytes, bytearray)) else str(body)
    medication = None
    if "\ndose;" in "\n" + text_body or "\nmed_range;" in "\n" + text_body:
        text_body, medication = take_medication_lines(text_body)
        body = text_body.encode("utf-8")
    parts = []
    if medication:
        start, end, doses, meds = medication
        meds_store = MedicationStore()
        meds_store.replace(start, end, doses, meds)
        meds_store.save()
        n = len({d[0] for d in doses})
        if n:
            parts.append(trn("medication for %d day", "medication for %d days", n) % n)
        else:
            parts.append(tr("medication (no doses in this period)"))
        if not text_body.strip():
            return True, tr("OK. Stored ") + ", ".join(parts) + "."
    incoming, problems = parse_payload(body)
    store = HealthStore()
    stored = store.merge(incoming)
    if stored:
        store.save()
    parts = [trn("%s for %d day", "%s for %d days", n) % (metric_info(m)[0].lower(), n)
             for m, n in stored.items()] + parts
    message = (tr("OK. Stored ") + ", ".join(parts) + ".") if parts else \
        tr("Nothing stored: no health values found in what was sent.")
    if problems:
        key = next((p for p in problems if p.startswith(tr("sleep times"))), problems[0])
        message += tr("\n%d line(s) skipped. %s") % (len(problems), key)
    return bool(parts), message


def write_sync_status(message, encrypted):
    stamp = dt.datetime.now().strftime("%Y-%m-%d %H:%M")
    how = tr("Encrypted.") if encrypted else tr("Not encrypted (the Shortcut or an older iPhone app).")
    try:
        with open(sync_status_path(), "w", encoding="utf-8") as f:
            f.write("%s\n%s\n%s\n" % (stamp, message.strip(), how))
    except OSError:
        pass


def new_sync_token():
    """Replace the token (the old one stops working at once; the receiver reads it per request)."""
    cfg = sync_config()
    cfg["token"] = secrets.token_urlsafe(18)
    path = os.path.join(data_dir(), "sync.json")
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f)
    os.replace(path + ".tmp", path)
    return cfg["token"]


def run_sync_server():
    """`moodlog --sync-server`: receive health data from the phone over the local network.

    It only accepts data (POST with the secret token). It never sends any data back.
    """
    import http.server

    cfg = sync_config()

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "Sottovoce/" + VERSION

        def reply(self, code, message):
            body = (message + "\n").encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def reply_json(self, code, doc):
            body = json.dumps(doc, ensure_ascii=False).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def route(self):
            return self.path.split("?", 1)[0].rstrip("/") or "/"

        def do_GET(self):
            if self.route() == "/api/ping":
                if not self.authorised():
                    self.reply_json(401, {"error": tr("Wrong or missing token.")})
                    return
                self.reply_json(200, {"app": "Moodlog", "version": VERSION})
                return
            self.reply(200, tr("Sottovoce sync is running. Send health data with POST /health."))

        def authorised(self):
            given = self.headers.get("Authorization", "")
            given = given[7:] if given.lower().startswith("bearer ") else given
            given = given or self.headers.get("X-Token", "")
            if not given and "?" in self.path:
                import urllib.parse
                given = (urllib.parse.parse_qs(self.path.split("?", 1)[1]).get("token") or [""])[0]
            return hmac.compare_digest(given.strip().encode(), sync_config()["token"].encode())

        def encrypted(self):
            """/api/e/...: everything inside is encrypted with the token; nothing is sent in clear."""
            route = self.route()
            if not crypto_available():
                self.reply_json(501, {"error": tr("Encrypted sync needs the python3-cryptography "
                                                  "package on the PC.")})
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                length = 0
            if not 0 < length <= 60 * 1024 * 1024:
                self.reply_json(400, {"error": tr("Empty request, or too large.")})
                return
            token = sync_config()["token"]
            try:
                doc = unseal(token, route, self.rfile.read(length))
            except ValueError:
                self.reply_json(401, {"error": tr("Could not read the request: the token doesn't match. "
                                                  "Copy it again from Sottovoce > Phone sync.")})
                return
            if route == "/api/e/ping":
                answer = {"app": "Moodlog", "version": VERSION}
            elif route == "/api/e/sync":
                try:
                    answer = sync_with_phone(json.dumps(doc))
                except (ValueError, OSError) as err:
                    self.reply_json(400, {"error": str(err)})
                    return
                if isinstance(doc, dict) and doc.get("app") == "android":
                    done = trn("Sottovoce for Android synced (%d change).",
                               "Sottovoce for Android synced (%d changes).", answer["changed"])
                else:
                    done = trn("Sottovoce for iPhone synced (%d change).",
                               "Sottovoce for iPhone synced (%d changes).", answer["changed"])
                write_sync_status(done % answer["changed"], True)
            elif route == "/api/e/health":
                lines = doc.get("lines") if isinstance(doc, dict) else None
                if not isinstance(lines, str):
                    self.reply_json(400, {"error": tr("Empty request, or too large.")})
                    return
                stored, message = store_health_lines(lines.encode("utf-8"))
                write_sync_status(message, True)
                answer = {"stored": stored, "message": message}
            else:
                self.reply_json(404, {"error": "unknown"})
                return
            body = seal(token, route, answer, reply=True)
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):
            if self.route().startswith("/api/e/"):
                self.encrypted()
                return
            if not self.authorised():
                if self.route().startswith("/api/"):
                    self.reply_json(401, {"error": tr("Wrong or missing token. Copy it again from "
                                                   "Sottovoce > Phone sync.")})
                    return
                self.reply(401, tr("Wrong or missing token. Copy it again from Sottovoce > Phone sync."))
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                length = 0
            limit = 50 * 1024 * 1024 if self.route() == "/api/sync" else 5 * 1024 * 1024
            if not 0 < length <= limit:
                if self.route().startswith("/api/"):
                    self.reply_json(400, {"error": tr("Empty request, or too large.")})
                    return
                self.reply(400, tr("Empty request (or larger than 5 MB)."))
                return
            body = self.rfile.read(length)
            if self.route() == "/api/sync":
                try:
                    state = sync_with_phone(body)
                except (ValueError, OSError) as err:
                    self.reply_json(400, {"error": str(err)})
                    return
                write_sync_status(trn("Sottovoce for iPhone synced (%d change).",
                                      "Sottovoce for iPhone synced (%d changes).", state["changed"])
                                  % state["changed"], False)
                self.reply_json(200, state)
                return
            stored, message = store_health_lines(body)
            write_sync_status(message, False)
            self.reply(200 if stored else 422, message)

        def log_message(self, fmt, *args):
            # never log the query string: it can carry the token
            args = tuple(a.split("?", 1)[0] if isinstance(a, str) else a for a in args)
            sys.stderr.write("moodlog-sync: %s\n" % (fmt % args))

    class Server(http.server.ThreadingHTTPServer):
        def server_bind(self):
            # HTTPServer looks this computer's name up (socket.getfqdn), which can hang for
            # minutes when the network's DNS doesn't answer (it did on a Mac): not needed here
            import socketserver
            socketserver.TCPServer.server_bind(self)
            self.server_name, self.server_port = self.server_address[:2]

    server = Server(("0.0.0.0", int(cfg["port"])), Handler)
    if sys.stdout is not None:    # a windowed .exe on Windows has no console
        print("Sottovoce sync listening on port %d" % cfg["port"], flush=True)
    script = os.path.realpath(os.path.abspath(sys.argv[0]))
    if IS_WINDOWS:
        # the installer closes the receiver and runs `--resume-sync` after an update
        import threading
        updated = threading.Event()
        with open(receiver_pid_path(), "w") as f:
            f.write(str(os.getpid()))
    else:
        updated = watch_for_update(script, server)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        return 0
    server.server_close()
    if updated.is_set():
        # Moodlog was updated (for example by apt): carry on with the new version, in the
        # same process, so a receiver started by systemd or by hand stays up to date.
        print("Sottovoce was updated: restarting the sync receiver", flush=True)
        restart_self(sys.argv[1:])
    return 0


def file_stamp(path):
    try:
        st = os.stat(path)
        return (st.st_ino, st.st_mtime_ns, st.st_size)
    except OSError:
        return None


def watch_for_update(script, server):
    """Stop `server` once `script` has been replaced and has stayed the same for a moment.
    Returns an Event that is set when that happened."""
    import threading
    updated = threading.Event()
    every = float(os.environ.get("MOODLOG_UPDATE_CHECK", "15"))
    start = file_stamp(script)

    def watch():
        seen = start
        while True:
            time_sleep(every)
            now = file_stamp(script)
            if now is None or now == start:
                seen = now
                continue
            if now != seen:          # still changing (an install in progress): look again
                seen = now
                continue
            try:                     # only switch to a file that is complete and valid
                compile(open(script, encoding="utf-8").read(), script, "exec")
            except (OSError, SyntaxError, ValueError):
                continue
            updated.set()
            server.shutdown()
            return

    if start is not None:
        threading.Thread(target=watch, daemon=True).start()
    return updated


def time_sleep(seconds):
    import time
    time.sleep(seconds)


# ----------------------------------------------------------------- Gridgets link

def gridgets_base():
    return os.environ.get("MOODLOG_GRIDGETS_DIR") or os.path.join(
        GLib.get_user_data_dir(), "gridgets")


class GridgetsLink:
    """Keeps Moodlog and the mood widget of the Gridgets GNOME extension in step.

    Gridgets stores one file per month, ~/.local/share/gridgets/mood/<year>/<month>.json,
    holding {"YYYY-MM-DD": level} with the same 1-5 scale as Moodlog.

    Moodlog's own CSV stays the source of truth. The widget holds one level per day: Moodlog
    gives it the day's latest entry. Two facts about the widget shape the rules:
      * it can only log *today*, so a change it makes is always for the day it wrote the file
        (and the file's time is when it was picked, which becomes the entry's time);
      * it rewrites the whole month from a copy it read at login/unlock, so the other days
        in a file it has just written may be out of date and must not overwrite Moodlog.
    """

    DATE = re.compile(r"\d{4}-\d{2}-\d{2}$")

    def __init__(self, store):
        self.store = store
        self.state_path = os.path.join(config_dir(), "gridgets-link.json")
        old_state = os.path.join(data_dir(), "gridgets-link.json")
        if old_state != self.state_path and os.path.exists(old_state) \
                and not os.path.exists(self.state_path):
            try:
                os.replace(old_state, self.state_path)  # moved here in version 1.8
            except OSError:
                pass
        self.enabled = True
        self.written = {}     # "YYYY-MM" -> {date: level} as Moodlog last left the file
        self.cleared = set()  # dates emptied in Moodlog; never refilled from a stale file
        self.mtimes = {}
        try:
            with open(self.state_path, encoding="utf-8") as f:
                state = json.load(f)
            self.enabled = bool(state.get("enabled", True))
            self.written = {k: dict(v) for k, v in (state.get("written") or {}).items()}
            self.cleared = set(state.get("cleared") or [])
        except (OSError, ValueError, AttributeError, TypeError):
            pass

    def save_state(self):
        try:
            tmp = self.state_path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump({"enabled": self.enabled, "written": self.written,
                           "cleared": sorted(self.cleared)}, f)
            os.replace(tmp, self.state_path)
        except OSError:
            pass

    def available(self):
        return os.path.isdir(gridgets_base())

    def active(self):
        return self.enabled and self.available()

    def month_path(self, key):
        year, month = key.split("-")
        return os.path.join(gridgets_base(), "mood", year, month + ".json")

    def read_month(self, key):
        """({date: level}, mtime) for a month file; (None, mtime) if it cannot be read."""
        path = self.month_path(key)
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            return {}, None
        try:
            with open(path, encoding="utf-8") as f:
                raw = json.load(f)
        except (OSError, ValueError):
            return None, mtime
        if not isinstance(raw, dict):
            return None, mtime
        levels = {}
        for day, level in raw.items():
            if (isinstance(day, str) and self.DATE.match(day) and day.startswith(key)
                    and isinstance(level, int) and not isinstance(level, bool)
                    and 1 <= level <= 5):
                levels[day] = level
        return levels, mtime

    def months(self):
        keys = {d.strftime("%Y-%m") for d, _m in self.store.moods()}
        keys.update(self.written)
        keys.add(dt.date.today().strftime("%Y-%m"))
        root = os.path.join(gridgets_base(), "mood")
        try:
            for year in os.listdir(root):
                if not re.fullmatch(r"\d{4}", year):
                    continue
                for name in os.listdir(os.path.join(root, year)):
                    if re.fullmatch(r"\d{2}\.json", name):
                        keys.add("%s-%s" % (year, name[:2]))
        except OSError:
            pass
        return sorted(keys)

    def changed_on_disk(self):
        for key in self.months():
            try:
                mtime = os.path.getmtime(self.month_path(key))
            except OSError:
                mtime = None
            if mtime != self.mtimes.get(key):
                return True
        return False

    def reconcile(self, key):
        """Sync one month both ways. Returns True if Sottovoce's own entries changed."""
        theirs, mtime = self.read_month(key)
        self.mtimes[key] = mtime
        if theirs is None:
            return False  # unreadable file: leave it alone rather than overwrite it
        year, month = (int(part) for part in key.split("-"))
        first = dt.date(year, month, 1)
        last_day = first.replace(day=calendar.monthrange(year, month)[1])
        mine = {}
        for day, _level in self.store.moods(first, last_day):
            mine[day.isoformat()] = self.store.latest_mood(day)
        before = self.written.get(key)
        if before is not None:
            for day in before:
                if day not in mine:
                    self.cleared.add(day)  # was linked, now empty: cleared in Moodlog
        self.cleared.difference_update(mine)

        changed = False
        if theirs != before:
            today = dt.date.today()
            clicked = dt.date.fromtimestamp(mtime).isoformat() if mtime else None
            for day, level in theirs.items():
                date = dt.date.fromisoformat(day)
                if date > today:
                    continue
                is_click = day == clicked and (before is None or before.get(day) != level)
                is_new = day not in mine and day not in self.cleared
                if (is_click or is_new) and mine.get(day) != level:
                    stamp = dt.datetime.fromtimestamp(mtime).strftime("%H:%M") if day == clicked else ""
                    self.store.add(date, stamp, level, "")
                    mine[day] = level
                    self.cleared.discard(day)
                    changed = True

        if mine != theirs:
            path = self.month_path(key)
            try:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                tmp = path + ".moodlog-tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump({d: mine[d] for d in sorted(mine)}, f, indent=2)
                os.replace(tmp, path)
                self.mtimes[key] = os.path.getmtime(path)
            except OSError:
                return changed
        self.written[key] = dict(mine)
        return changed

    def reconcile_all(self):
        if not self.active():
            return False
        changed = False
        for key in self.months():
            changed = self.reconcile(key) or changed
        self.save_state()
        return changed


