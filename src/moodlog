class SeveralPreview(Gtk.DrawingArea):
    """A tiny calendar day with three moods: as a grid, or only the latest."""

    def __init__(self, mode):
        super().__init__()
        self.mode = mode
        self.set_content_width(46)
        self.set_content_height(46)
        self.set_halign(Gtk.Align.CENTER)
        self.set_draw_func(self._draw)

    def _draw(self, _a, cr, w, h):
        th = theme()
        x, y, size = 2, 2, min(w, h) - 4
        cr.save()
        rounded_rect(cr, x, y, size, size, 8)
        cr.clip()
        if self.mode == "latest":
            src(cr, th["moods"][4])
            cr.paint()
            draw_face(cr, x + size / 2, y + size * 0.55, size * 0.24, 4, FACE_INK[4], outline=False)
        else:
            src(cr, th["ink"], 0.06)
            cr.paint()
            moods, gap, top = [2, 3, 4], 2, size * 0.22
            tw, th_ = (size - gap) / 2, (size - top - gap) / 2
            for i, m in enumerate(moods):
                r, c = divmod(i, 2)
                cr.rectangle(x + c * (tw + gap), y + top + r * (th_ + gap), tw, th_)
                src(cr, th["moods"][m])
                cr.fill()
        cr.restore()


