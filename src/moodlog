        GLib.source_remove(self._timer)
        return False

    def on_change_token(self, *_):
        def change():
            try:
                self.token_label.set_text(new_sync_token())
            except OSError as err:
                self.error = tr("Could not change the token: %s") % err
                self.update_status()
        ConfirmWindow(self, tr("Change the token?"),
                      tr("The old token stops working at once. Enter the new one in the Sottovoce "
                         "app on your phone (Settings) and in the Shortcut, if you use it. Worth doing once "
                         "after updating to encrypted sync, since older versions sent the token "
                         "unencrypted."),
                      [(tr("Change token"), change, "suggested-action")]).present()

    def on_copy(self, _btn, value):
        self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(value))

    def on_switch(self, _switch, state):
        if self._setting:
            return False
        ok, err = receiver_set(state)
        if not ok:
            self.error = (tr("Could not start the receiver (%s). You can also start it by hand "
                             "in a terminal: moodlog --sync-server") if state else
                          tr("Could not stop the receiver (%s).")) % (err or tr("systemctl failed"))
        else:
            self.error = ""
        GLib.idle_add(self.update_status)
        return False

    def update_status(self):
        active = receiver_running()
        self._setting = True
        self.switch.set_active(active)
        self._setting = False
        lines = []
        if getattr(self, "error", ""):
            lines.append(self.error)
        lines.append(tr("The receiver is running.") if active else tr("The receiver is off."))
        try:
            with open(sync_status_path(), encoding="utf-8") as f:
                stamp, _, message = f.read().strip().partition("\n")
            lines.append(tr("Last sync attempt %s. %s") % (stamp, message.replace("\n", " ")))
        except OSError:
            lines.append(tr("Nothing received from the phone yet."))
        self.status.set_text("\n".join(lines))
        return True


