    def update_prompt(self):
        """The question shows only in an empty note, and only if prompts are on."""
        on = bool(self.prefs["prompts"]) and not self.current_note()
        self.prompt_label.set_text(prompt_for(self.selected, self.prompt_offset))
        self.prompt_label.set_visible(on)
        self.prompt_next.set_visible(on)

