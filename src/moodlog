def ease_in_out(x):
    x = max(0.0, min(1.0, x))
    return 4 * x ** 3 if x < 0.5 else 1 - (-2 * x + 2) ** 3 / 2


class TourFace(Gtk.DrawingArea):
    """A face that bobs gently and smiles more and more: the tour's friendly mascot."""

    def __init__(self, size=84):
        super().__init__()
        self.set_content_width(size)
        self.set_content_height(size)
        self.set_halign(Gtk.Align.CENTER)
        self.start = None
        self.set_draw_func(self._draw)
        self.add_tick_callback(self._tick)

    def _tick(self, _w, clock):
        if self.start is None:
            self.start = clock.get_frame_time()
        self.queue_draw()
        return True

    def _draw(self, _a, cr, w, h):
        th = theme()
        clock = self.get_frame_clock()
        t = 0.0 if self.start is None or clock is None else (clock.get_frame_time() - self.start) / 1e6
        mood = 3 if t < 0.6 else 4 if t < 1.3 else 5        # okay -> good -> great
        bob = math.sin(t * 2.4) * 3
        r = min(w, h) / 2 - 6
        cx, cy = w / 2, h / 2 + bob
        grow = 0.85 + 0.15 * ease_in_out(t / 0.5)          # a small pop when it appears
        src(cr, th["moods"][mood], 0.95)
        cr.arc(cx, cy, r * grow, 0, 2 * math.pi)
        cr.fill()
        draw_face(cr, cx, cy, r * grow, mood, "#1b1b1b" if mood in (3, 4) else "#ffffff", outline=False)


class TourOverlay(Gtk.Overlay):
    """Dims the window, cuts a spotlight around one part of it and explains that part."""

    CARD_WIDTH = 380

    def __init__(self, win, on_close):
        super().__init__(hexpand=True, vexpand=True)
        self.win, self.on_close = win, on_close
        self.step, self.t0 = 0, None
        self.hole_from = self.hole_to = None       # (x, y, w, h) or None for "no spotlight"
        self.card_from = self.card_to = None
        self.shade = Gtk.DrawingArea(hexpand=True, vexpand=True)
        self.shade.set_draw_func(self._draw)
        self.shade.add_controller(Gtk.GestureClick())     # clicks stop here, not on the app
        self.set_child(self.shade)

        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                            halign=Gtk.Align.START, valign=Gtk.Align.START)
        self.card.add_css_class("tour-card")
        self.card.set_size_request(self.CARD_WIDTH, -1)
        self.face = TourFace()
        # max_width_chars=1 with wrapping: the labels take the card's fixed width instead of
        # asking for one long line, so the card is always CARD_WIDTH wide
        self.title = Gtk.Label(xalign=0, wrap=True, max_width_chars=1)
        self.title.add_css_class("title-3")
        self.body = Gtk.Label(xalign=0, wrap=True, max_width_chars=1)
        self.body.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self.dots = Gtk.Label(xalign=0)
        self.dots.add_css_class("dim-label")
        self.skip = Gtk.Button(label=tr("Skip tour"))
        self.skip.add_css_class("flat")
        self.skip.connect("clicked", lambda *_: self.close())
        self.back = Gtk.Button(label=tr("Back"))
        self.back.connect("clicked", lambda *_: self.go(self.step - 1))
        self.next = Gtk.Button(label=tr("Next"))
        self.next.add_css_class("suggested-action")
        self.next.connect("clicked", lambda *_: self.go(self.step + 1))
        row = Gtk.Box(spacing=8)
        row.append(self.skip)
        row.append(Gtk.Box(hexpand=True))
        for b in (self.back, self.next):
            row.append(b)
        self.extra = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        for wdg in (self.face, self.title, self.body, self.extra, self.dots, row):
            self.card.append(wdg)
        self.add_overlay(self.card)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self._key)
        self.add_controller(keys)
        self.add_tick_callback(self._tick)
        self.go(0)

    # -- steps

    def target(self, key):
        """The widget a step points at, and its spotlight rectangle in overlay coordinates."""
        if key is None or key == "customize":
            return None
        if key.startswith("tab:"):
            name = key[4:]
            child = self.win.tour_refs["tabs"].get_first_child()
            pages = [p.get_name() for p in self.win.stack.get_pages()]
            for i, page in enumerate(pages):
                if child is None:
                    break
                if page == name:
                    widget = child
                    break
                child = child.get_next_sibling()
            else:
                return None
        else:
            widget = self.win.tour_refs.get(key)
        widgets = widget if isinstance(widget, tuple) else (widget,)
        boxes = []
        for wdg in widgets:     # several widgets: one spotlight around all of them
            if wdg is None or not wdg.get_mapped():
                continue
            ok, rect = wdg.compute_bounds(self)
            if ok:
                boxes.append((rect.get_x(), rect.get_y(), rect.get_x() + rect.get_width(),
                              rect.get_y() + rect.get_height()))
        if not boxes:
            return None
        x0, y0 = min(b[0] for b in boxes), min(b[1] for b in boxes)
        x1, y1 = max(b[2] for b in boxes), max(b[3] for b in boxes)
        pad = 6
        return (x0 - pad, y0 - pad, x1 - x0 + 2 * pad, y1 - y0 + 2 * pad)

    def go(self, step):
        if step < 0:
            return
        if 0 <= step < len(TOUR_STEPS) and TOUR_STEPS[step][0] == "tab:dreams" \
                and not self.win.prefs["dreams"]:
            step += 1 if step > self.step else -1      # dreams turned off: skip that step
            if step < 0:
                return
        if step >= len(TOUR_STEPS):
            self.close()
            return
        self.win.stack.set_visible_child_name("log")
        self.hole_from = self.current_hole()
        self.card_from = self.current_card()
        self.step, self.t0 = step, None
        key, title, body = TOUR_STEPS[step]
        self.face.set_visible(key is None)
        child = self.extra.get_first_child()
        while child:
            self.extra.remove(child)
            child = self.extra.get_first_child()
        if key == "customize":
            scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True)
            scroll.set_max_content_height(330)   # the list grows; the card must still fit the window
            scroll.set_child(customize_options(self.win, compact=True))
            self.extra.append(scroll)
        self.extra.set_visible(key == "customize")
        self.title.set_text(title)
        self.body.set_text(body)
        self.dots.set_text(" ".join("●" if i == step else "○" for i in range(len(TOUR_STEPS))))
        self.back.set_visible(step > 0)
        self.skip.set_visible(step < len(TOUR_STEPS) - 1)
        self.next.set_label(tr("Let's start") if step == len(TOUR_STEPS) - 1 else tr("Next"))
        self.card.set_opacity(0.0)
        self.next.grab_focus()

    def close(self):
        self.on_close()

    def _key(self, _c, keyval, _code, _state):
        name = Gdk.keyval_name(keyval) or ""
        if name == "Escape":
            self.close()
        elif name in ("Right", "Return", "KP_Enter", "space"):
            self.go(self.step + 1)
        elif name == "Left":
            self.go(self.step - 1)
        else:
            return False
        return True

    # -- layout and animation

    def progress(self):
        clock = self.get_frame_clock()
        if self.t0 is None or clock is None:
            return 0.0
        return ease_in_out((clock.get_frame_time() - self.t0) / 450000)

    def current_hole(self):
        return self.lerp_rect(self.hole_from, self.hole_to, self.progress())

    @staticmethod
    def lerp_rect(a, b, p):
        if a is None and b is None:
            return None
        if a is None:   # grow out of the centre of b
            a = (b[0] + b[2] / 2, b[1] + b[3] / 2, 0, 0)
        if b is None:
            b = (a[0] + a[2] / 2, a[1] + a[3] / 2, 0, 0)
        return tuple(x + (y - x) * p for x, y in zip(a, b))

    def card_place(self, hole):
        """Where the card goes: under the spotlight, else above, else beside it, else centred.

        The answer is kept for the step (and window size), so the card never jumps between
        two places from one frame to the next."""
        W, H = self.get_width(), self.get_height()
        cw, ch = self.card_size()
        key = (self.step, W, H, cw, ch, None if hole is None else tuple(round(v / 4) for v in hole))
        if getattr(self, "_place", (None,))[0] == key:
            return self._place[1]
        self._place = (key, self._choose_place(hole, W, H, cw, ch))
        return self._place[1]

    @staticmethod
    def _choose_place(hole, W, H, cw, ch, margin=16, gap=26):
        if hole is None:
            return ((W - cw) / 2, max(margin, (H - ch) / 2))
        x, y, w, h = hole
        across = min(max(margin, x + w / 2 - cw / 2), W - cw - margin)
        down = min(max(margin, y + h / 2 - ch / 2), H - ch - margin)
        if y + h + gap + ch <= H - margin:
            return (across, y + h + gap)
        if y - gap - ch >= margin:
            return (across, y - gap - ch)
        room_right, room_left = W - (x + w) - gap - margin, x - gap - margin
        if room_right >= cw:
            return (x + w + gap, down)
        if room_left >= cw:
            return (x - gap - cw, down)
        # no side has room: go where there is most, inside the window (it may cover an edge)
        if room_right >= room_left:
            return (max(margin, W - cw - margin), down)
        return (margin, down)

    def card_size(self):
        """The card's natural size: it doesn't depend on where the card sits."""
        # measure() counts the margins too, and the margins are how the card is placed:
        # take them out, or the card's position would change its own size
        c = self.card
        mx = c.get_margin_start() + c.get_margin_end()
        my = c.get_margin_top() + c.get_margin_bottom()
        cw = c.measure(Gtk.Orientation.HORIZONTAL, -1)[1] - mx
        ch = c.measure(Gtk.Orientation.VERTICAL, cw + mx)[1] - my
        return cw, ch

    def current_card(self):
        if self.card_to is None:
            return None
        return self.lerp_point(self.card_from, self.card_to, self.progress())

    @staticmethod
    def lerp_point(a, b, p):
        if a is None:
            return b
        return (a[0] + (b[0] - a[0]) * p, a[1] + (b[1] - a[1]) * p)

    def _tick(self, _w, clock):
        now = clock.get_frame_time()
        if self.t0 is None:
            self.t0 = now
        self.hole_to = self.target(TOUR_STEPS[self.step][0])
        self.card_to = self.card_place(self.hole_to)
        x, y = self.current_card()
        self.card.set_margin_start(int(x))
        self.card.set_margin_top(int(y))
        fade = (now - self.t0) / 1e6
        self.card.set_opacity(max(0.0, min(1.0, (fade - 0.15) / 0.3)))
        self.shade.queue_draw()
        return True

    def _draw(self, _a, cr, w, h):
        th = theme()
        p = self.progress()
        hole = self.lerp_rect(self.hole_from, self.hole_to, p)
        cr.set_fill_rule(1)  # even-odd: the spotlight stays clear
        cr.rectangle(0, 0, w, h)
        if hole and hole[2] > 1 and hole[3] > 1:
            rounded_rect(cr, *hole, min(16, hole[3] / 2))
        cr.set_source_rgba(0.04, 0.04, 0.06, 0.62)
        cr.fill()
        if not hole or hole[2] < 2:
            return
        clock = self.get_frame_clock()
        t = clock.get_frame_time() / 1e6 if clock else 0.0
        pulse = 0.55 + 0.45 * (0.5 + 0.5 * math.sin(t * 3.2))
        cr.set_line_width(3)
        rounded_rect(cr, *hole, min(16, hole[3] / 2))
        src(cr, "#3584e4", pulse)
        cr.stroke()
        # a line from the card to the spotlight
        card = self.current_card()
        if card is None or p < 0.6:
            return
        cw, ch = self.card_size()
        left, top, right, bottom = card[0], card[1], card[0] + cw, card[1] + ch
        hx, hy = hole[0] + hole[2] / 2, hole[1] + hole[3] / 2
        if top >= hole[1] + hole[3]:          # card below the spotlight
            sx, sy, ex, ey = min(max(hx, left + 30), right - 30), top, hx, hole[1] + hole[3] + 3
        elif bottom <= hole[1]:               # card above
            sx, sy, ex, ey = min(max(hx, left + 30), right - 30), bottom, hx, hole[1] - 3
        elif left >= hole[0] + hole[2] / 2:   # card on the right
            sx, sy, ex, ey = left, min(max(hy, top + 30), bottom - 30), hole[0] + hole[2] + 3, hy
        else:                                 # card on the left
            sx, sy, ex, ey = right, min(max(hy, top + 30), bottom - 30), hole[0] - 3, hy
        if hole[0] <= sx <= hole[0] + hole[2] and hole[1] <= sy <= hole[1] + hole[3]:
            return                            # the card sits on the spotlight: no line
        alpha = min(1.0, (p - 0.6) / 0.3)
        src(cr, "#3584e4", 0.9 * alpha)
        cr.set_line_width(2.5)
        cr.set_line_cap(1)
        mx = (sx + ex) / 2
        cr.move_to(sx, sy)
        cr.curve_to(sx, (sy + ey) / 2, ex, (sy + ey) / 2, ex, ey) if abs(sx - ex) < abs(sy - ey) * 3 \
            else cr.curve_to(mx, sy, mx, ey, ex, ey)
        cr.stroke()
        cr.arc(ex, ey, 4.5, 0, 2 * math.pi)
        cr.fill()


