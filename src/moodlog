def draw_pill(cr, cx, cy, r, status, liquid=False):
    """A small pill (or a drop, for liquids) in the colour of the dose's status."""
    colour = {"taken": "#34c759", "skipped": "#8e8e93"}.get(status, "#ff9f0a")
    cr.save()
    cr.translate(cx, cy)
    if liquid:
        cr.move_to(0, -r)
        cr.curve_to(r * 0.9, -r * 0.1, r * 0.75, r, 0, r)
        cr.curve_to(-r * 0.75, r, -r * 0.9, -r * 0.1, 0, -r)
        cr.close_path()
        src(cr, colour)
        cr.fill()
    else:
        cr.rotate(-math.pi / 4)
        w, h = r * 0.62, r * 1.9
        def capsule():
            cr.new_path()
            cr.arc(0, -h / 2 + w, w, math.pi, 0)
            cr.arc(0, h / 2 - w, w, 0, math.pi)
            cr.close_path()
        capsule()
        cr.save()
        cr.clip()
        src(cr, colour)
        cr.rectangle(-w, -h / 2, 2 * w, h / 2)
        cr.fill()
        src(cr, colour, 0.35)
        cr.rectangle(-w, 0, 2 * w, h / 2)
        cr.fill()
        cr.restore()
        capsule()
        src(cr, colour)
        cr.set_line_width(max(1.0, r * 0.12))
        cr.stroke()
    cr.restore()


def take_medication_lines(text):
    """Pull the medication lines Moodlog for iPhone adds to its health data:
         med_range;FIRST DAY;LAST DAY          the period the doses below cover (all of it)
         med;active|archived;scheduled|as_needed;NAME
         dose;WHEN;taken|skipped;AMOUNT;UNIT;NAME
    Returns (the other lines, (start, end, doses, meds) or None)."""
    rest, doses, meds, span = [], [], {}, None
    for raw in str(text).replace("\r", "\n").split("\n"):
        line = raw.strip()
        head = line.split(";", 1)[0].strip().lower()
        if head == "med_range":
            parts = line.split(";")
            try:
                span = (dt.date.fromisoformat(parts[1].strip()), dt.date.fromisoformat(parts[2].strip()))
            except (IndexError, ValueError):
                pass
        elif head == "med":
            parts = line.split(";", 3)
            if len(parts) == 4 and parts[3].strip():
                meds[parts[3].strip()] = {"archived": parts[1].strip() == "archived",
                                          "as_needed": parts[2].strip() == "as_needed"}
        elif head == "dose":
            parts = line.split(";", 5)
            if len(parts) < 6 or not parts[5].strip() or parts[2].strip() not in DOSE_STATUSES:
                continue
            when = parse_when(parts[1])
            if when is None:
                continue
            amount = parse_number(parts[3]) if parts[3].strip() else None
            doses.append((when.date(), when.strftime("%H:%M") if has_clock(parts[1]) else "",
                          parts[2].strip(), amount, parts[4].strip(), parts[5].strip()))
        else:
            rest.append(raw)
    if span is None:
        if not doses:
            return "\n".join(rest), None
        span = (min(d[0] for d in doses), max(d[0] for d in doses))
    return "\n".join(rest), (span[0], span[1], doses, meds)


