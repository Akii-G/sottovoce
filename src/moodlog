class SurveyChart(Canvas):
    """PHQ-9 and GAD-7 scores over time, one line each, on the same 0-27 points axis."""

    def __init__(self, win, kinds=SURVEY_KINDS, height=190):
        super().__init__(-1, height)
        self.win, self.kinds = win, kinds
        self.set_hexpand(True)

    def colour(self, kind, th):
        return th["health"] if kind == "phq9" else th["anxiety"]

    def draw(self, cr, w, h, th):
        found = [s for s in self.win.surveys.items if s["kind"] in self.kinds]
        if not found:
            no_data(cr, self, w, h, th)
            return
        first, last = found[0]["date"], found[-1]["date"]
        span = max(1, (last - first).days)
        top = max(survey_max(k) for k in self.kinds)
        left, right, up, down = 30, 14, 10, 36
        pw, ph = w - left - right, h - up - down

        def px(day):
            return left + (pw * (day - first).days / span if len(found) > 1 and span else pw / 2)

        def py(score):
            return up + ph * (1 - score / top)

        cr.set_line_width(1)
        for v in range(0, top + 1, 9 if top > 21 else 7):
            src(cr, th["grid"])
            cr.move_to(left, py(v) + 0.5)
            cr.line_to(w - right, py(v) + 0.5)
            cr.stroke()
            text(cr, self, str(v), left - 6, py(v), 8.5, th["muted"], ax=1, ay=0.5)
        text(cr, self, fmt_date(first, "%-d %b %Y"), left, h - down + 6, 8.5, th["muted"])
        if last != first:
            text(cr, self, fmt_date(last, "%-d %b %Y"), w - right, h - down + 6, 8.5, th["muted"], ax=1)
        lx = left
        for kind in self.kinds:
            points = [s for s in found if s["kind"] == kind]
            if not points:
                continue
            colour = self.colour(kind, th)
            src(cr, colour)
            cr.set_line_width(2)
            for i, s in enumerate(points):
                (cr.line_to if i else cr.move_to)(px(s["date"]), py(survey_score(s)))
            cr.stroke()
            for s in points:
                x, y = px(s["date"]), py(survey_score(s))
                cr.arc(x, y, 5, 0, 2 * math.pi)
                src(cr, th["surface"])
                cr.fill()
                cr.arc(x, y, 4, 0, 2 * math.pi)
                src(cr, colour)
                cr.fill()
                self.hits.append((x - 9, y - 9, 18, 18, tr("%s on %s: %d of %d") % (
                    survey_name(kind), fmt_date(s["date"], "%-d %b %Y"), survey_score(s),
                    survey_max(kind))))
            if len(self.kinds) > 1:    # the legend
                cr.arc(lx + 5, h - 9, 4, 0, 2 * math.pi)
                src(cr, colour)
                cr.fill()
                tw, _th = text(cr, self, survey_name(kind), lx + 13, h - 9, 9, th["ink2"], ay=0.5)
                lx += tw + 32


