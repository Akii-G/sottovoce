                       else tr("Notes") if include_notes else tr("Dreams"))
            cols.append((heading, W - 2 * M - sum(c[1] for c in cols)))
        xs, x = [], M
        for _name, w in cols:
            xs.append(x)
            x += w

        def day_head():
            for (name, _w), x in zip(cols, xs):
                pdf.text(name, x, pdf.y, 7.5, ink["muted"], bold=True)
            pdf.y += 14
            src(cr, ink["axis"])
            cr.set_line_width(0.6)
            cr.move_to(M, pdf.y - 3)
            cr.line_to(W - M, pdf.y - 3)
            cr.stroke()
        day_head()
        for d in rows:
            items = store.entries(d)
            notes = ""
            lines = []
            if include_notes:    # private notes never go in the report
                lines += [("%s  %s" % (e[0], " ".join(e[2].split()))).strip()
                          for e in items if e[2].strip() and not is_private(e, 7)]
            day_dreams = dreams.on(d) if show_dreams else []
            if dream_mode == "text":   # private dreams are counted, but their text stays out
                lines += [tr("Dream: %s") % " ".join(x[3].split()) for x in day_dreams
                          if x[3].strip() and not is_private(x, 6)]
            notes = "\n".join(lines)
            h = 12
            if notes:
                _w, h = pdf.text(notes, xs[-1], 0, 7.5, measure=True, width=cols[-1][1] - 4)
                h = max(h, 12)
            if pdf.ensure(h + 6):
                day_head()
            y = pdf.y
            if d.weekday() >= 5:
                cr.rectangle(M, y - 2, W - 2 * M, h + 4)
                src(cr, ink["tile"])
                cr.fill()
            pdf.text(fmt_date(d, "%a %-d %b"), xs[0], y, 8, ink["ink"])
            avg = store.day_avg(d)
            if avg:
                cr.rectangle(xs[1], y + 1.5, 7, 7)
                src(cr, ink["moods"][to_level(avg)])
                cr.fill()
                count = len([e for e in items if e[1]])
                label = "%s %.1f" % (MOOD_NAMES[to_level(avg)], avg)
                if count > 1:
                    label += " (%d)" % count
                pdf.text(label, xs[1] + 11, y, 8, ink["ink"])
            for k, (index, _key, _name, _hint) in enumerate(SCALES):
                v = store.day_scale(d, index)
                pdf.text(("%.1f" % v).replace(".0", "") if v else "", xs[2 + k], y, 8, ink["ink"])
            col = 4
            if has_sleep:
                pdf.text("%.1f" % sleep[d] if d in sleep else "", xs[col], y, 8, ink["ink"])
                col += 1
            marks = ", ".join(str(number[id(e)]) for e in evs if e[0] == d)
            pdf.text(marks, xs[col], y, 8, ink["ink"], bold=True)
            col += 1
            if show_dreams and day_dreams:
                if any(dreams.is_nightmare(x) for x in day_dreams):
                    mark = tr("Nightmare")
                elif any(x[1] == "pleasant" for x in day_dreams):
                    mark = tr("Pleasant")
                elif all("forgotten" in dream_tags(x) and not x[3].strip() for x in day_dreams):
                    mark = tr("Forgotten")
                else:
                    mark = tr("Yes")
                pdf.text(mark, xs[col], y, 7.5, ink["ink"], bold=mark == tr("Nightmare"))
            if notes:
                pdf.text(notes, xs[-1], y, 7.5, ink["ink2"], width=cols[-1][1] - 4)
            pdf.y += h + 5
        pdf.y += 6
    if steps and include_health:
        pass  # steps stay in the spreadsheet export; the report keeps to what matters most
    pages = pdf.page
    pdf.finish()
    return pages


# ----------------------------------------------------------------- backup, restore, merging

DATA_FILES = ["moods.csv", "events.csv", "health.csv", "dreams.csv", "medications.json", "surveys.json",
              "appointment.json", "sync.json", "corrections.json",
              "sync-last.txt"]
CONTENT_FILES = ["moods.csv", "events.csv", "health.csv", "dreams.csv", "medications.json",
                 "surveys.json", "appointment.json"]
MANIFEST = "moodlog-backup.json"


class BackupError(Exception):
    pass


def make_backup(path, folder=None):
    """Zip the data files of `folder` (default: the data folder) into `path`."""
    import zipfile
    folder = folder or data_dir()
    names = [n for n in DATA_FILES if os.path.exists(os.path.join(folder, n))]
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    tmp = path + ".tmp"
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr(MANIFEST, json.dumps({
            "app": "Moodlog", "version": VERSION,
            "created": dt.datetime.now().strftime("%Y-%m-%d %H:%M"), "files": names}, indent=2))
        for name in names:
            z.write(os.path.join(folder, name), name)
    os.replace(tmp, path)
    return names


def read_backup(path):
    """Check a backup and return ({file name: bytes}, info). Only known data files are taken."""
    import zipfile
    try:
        with zipfile.ZipFile(path) as z:
            names = set(z.namelist())
            info = {}
            if MANIFEST in names:
                try:
                    info = json.loads(z.read(MANIFEST).decode("utf-8"))
                except ValueError:
                    info = {}
            files = {n: z.read(n) for n in DATA_FILES if n in names}
    except (zipfile.BadZipFile, OSError) as err:
        raise BackupError(tr("This file is not a Sottovoce backup (%s).") % err)
    if not any(n in files for n in CONTENT_FILES):
        raise BackupError(tr("This file is not a Sottovoce backup: it has no moods, events or "
                          "health data in it."))
    if "moods.csv" in files and not files["moods.csv"].lstrip(b"\xef\xbb\xbf").startswith(b"date"):
        raise BackupError(tr("The moods file in this backup is damaged."))
    return files, info


def restore_backup(path):
    """Replace the data with a backup. A copy of the current data is saved first.
    Returns the path of that safety copy."""
    files, _info = read_backup(path)
    folder = data_dir()
    safety = os.path.join(folder, "backups",
                          dt.datetime.now().strftime("before-restore-%Y%m%d-%H%M%S.zip"))
    make_backup(safety)
    for name in CONTENT_FILES + ["sync.json"]:
        target = os.path.join(folder, name)
        if name in files:
            tmp = target + ".tmp"
            with open(tmp, "wb") as f:
                f.write(files[name])
            os.replace(tmp, target)
        elif name in CONTENT_FILES and os.path.exists(target):
            os.remove(target)  # the backup had none of this: restore that state too
    return safety


def merge_folder_into(src, dst_store, dst_events, dst_health, dst_dreams=None, dst_surveys=None,
                      dst_appointment=None):
    """Add everything from the data files in folder `src` that the destination lacks."""
    added = dst_store.absorb(Store(os.path.join(src, "moods.csv")))
    if dst_appointment is not None:
        added += dst_appointment.absorb(AppointmentStore(os.path.join(src, "appointment.json")))
    if dst_surveys is not None:
        added += dst_surveys.absorb(SurveyStore(os.path.join(src, "surveys.json")))
    added += dst_events.absorb(EventStore(os.path.join(src, "events.csv")))
    if dst_dreams is not None:
        added += dst_dreams.absorb(DreamStore(os.path.join(src, "dreams.csv")))
    health = HealthStore(os.path.join(src, "health.csv"))
    for metric, days in health.values.items():
        mine = dst_health.values.setdefault(metric, {})
        for day, value in days.items():
            if day not in mine:
                mine[day] = value
                added += 1
    return added


CONFLICT_RE = re.compile(r"^(moods|events|health|dreams)\b.*conflict.*\.csv$", re.IGNORECASE)


def conflict_files(folder=None):
    """Copies a sync app made when both computers changed a file at once.
    Syncthing: moods.sync-conflict-20261118-...csv; Nextcloud: moods (conflicted copy ...).csv"""
    folder = folder or data_dir()
    try:
        names = os.listdir(folder)
    except OSError:
        return []
    return sorted((m.group(1).lower(), os.path.join(folder, n)) for n in names
                  for m in [CONFLICT_RE.match(n)] if m and n.lower() not in
                  ("moods.csv", "events.csv", "health.csv", "dreams.csv"))


def merge_conflicts(store, events, health, dreams=None):
    """Fold every conflict copy into the main files, then move the copies aside."""
    dreams = dreams if dreams is not None else DreamStore()
    found = conflict_files()
    if not found:
        return 0, 0
    added = 0
    parked = os.path.join(data_dir(), "backups", "merged-conflicts")
    os.makedirs(parked, exist_ok=True)
    for kind, path in found:
        if kind == "moods":
            added += store.absorb(Store(path))
        elif kind == "events":
            added += events.absorb(EventStore(path))
        elif kind == "dreams":
            added += dreams.absorb(DreamStore(path))
        else:
            for metric, days in HealthStore(path).values.items():
                mine = health.values.setdefault(metric, {})
                for day, value in days.items():
                    if day not in mine:
                        mine[day] = value
                        added += 1
    store.save()
    events.save()
    health.save()
    if dreams.items or dreams.deleted or os.path.exists(dreams.path):
        dreams.save()
    for _kind, path in found:
        os.replace(path, os.path.join(parked, os.path.basename(path)))
    return len(found), added


