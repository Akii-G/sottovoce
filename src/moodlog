def option_row(title, hint, widget):
    """A heading, a small grey hint under it, and a switch (or another control) on the right."""
    row = Gtk.Box(spacing=12)
    texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
    name = Gtk.Label(label=title, xalign=0)
    name.add_css_class("heading")
    texts.append(name)
    sub = Gtk.Label(label=hint, xalign=0, wrap=True, max_width_chars=30)
    sub.add_css_class("dim-label")
    sub.add_css_class("caption")
    texts.append(sub)
    row.append(texts)
    widget.set_valign(Gtk.Align.CENTER)
    row.append(widget)
    return row


def customize_more(win):
    """The rest of "Customize your experience" (its own window only, not the tour): the daily
    reminder, the kind word on hard days and the Gridgets link. Each change applies at once."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    cfg = load_config()
    on, time = reminder_settings(cfg)
    status = Gtk.Label(xalign=0, wrap=True, max_width_chars=30, visible=False)
    status.add_css_class("error")
    status.add_css_class("caption")
    remind = Gtk.Switch(active=on)
    h, m = (int(x) for x in time.split(":"))
    hour = Gtk.SpinButton.new_with_range(0, 23, 1)
    minute = Gtk.SpinButton.new_with_range(0, 59, 5)

    def two_digits(spin):
        spin.set_text("%02d" % spin.get_value_as_int())
        return True
    for spin, value in ((hour, h), (minute, m)):
        spin.set_value(value)
        spin.set_numeric(True)
        spin.set_width_chars(2)
        spin.connect("output", two_digits)
    pending = {"id": 0}

    def apply_now():
        pending["id"] = 0
        when = "%02d:%02d" % (hour.get_value_as_int(), minute.get_value_as_int())
        ok, err = apply_reminder(remind.get_active(), when)
        status.set_visible(not ok)
        if not ok:
            status.set_text(tr("Could not set up the reminder (%s).") % (err or tr("systemctl failed")))
        return False

    def apply_soon(*_):   # spinning through minutes shouldn't rewrite the timer each step
        if pending["id"]:
            GLib.source_remove(pending["id"])
        pending["id"] = GLib.timeout_add(700, apply_now)
    remind.connect("notify::active", apply_soon)
    hour.connect("value-changed", apply_soon)
    minute.connect("value-changed", apply_soon)
    box.append(option_row(tr("Remind me once a day"),
                          tr("A quiet notification, only on days you haven't logged a mood yet. "
                             "No streaks, no guilt: just a gentle nudge."), remind))
    when = Gtk.Box(spacing=6)
    when.append(Gtk.Label(label=tr("At"), xalign=0, hexpand=True))
    when.append(hour)
    when.append(Gtk.Label(label=":"))
    when.append(minute)
    when.set_sensitive(on)
    remind.connect("notify::active", lambda w, _p: when.set_sensitive(w.get_active()))
    box.append(when)
    box.append(status)

    kind = Gtk.Switch(active=cfg.get("kind_word", True))

    def on_kind(w, _p):
        c = load_config()
        c["kind_word"] = w.get_active()
        save_config(c)
        win.refresh_kind_word()
    kind.connect("notify::active", on_kind)
    box.append(option_row(tr("A kind word on hard days"),
                          tr("After a few very hard days close together, the Log shows a short, kind note "
                             "with a helpline. It never tells anyone; you can hide it any time."), kind))

    week = Gtk.Switch(active=cfg.get("week_card", True))

    def on_week(w, _p):
        c = load_config()
        c["week_card"] = w.get_active()
        save_config(c)
        win.refresh_week()
    week.connect("notify::active", on_week)
    box.append(option_row(tr("Your week, gently"),
                          tr("On Sunday evening and on Monday, a few calm words about your week: "
                             "days logged, the usual mood, your best day. No scores."), week))

    if win.link.available():
        link = Gtk.Switch(active=win.link.enabled)
        link.connect("notify::active", win.on_link_toggled)
        box.append(option_row(tr("Gridgets"),
                              tr("Linked with the Gridgets mood widget on your desktop: moods go both ways."),
                              link))
    return box


class PrivacyWindow(Gtk.Window):
    """The privacy policy in short, with a link to the full one."""

    def __init__(self, parent):
        super().__init__(title=tr("Privacy"), transient_for=parent, modal=True)
        self.parent_window = parent
        self.set_default_size(520, 660)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for side in ("top", "bottom", "start", "end"):
            getattr(col, "set_margin_" + side)(20)
        head = Gtk.Label(label=tr("Your data is yours"), xalign=0, wrap=True)
        head.add_css_class("title-2")
        col.append(head)
        for title, text in PRIVACY_POINTS:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            heading = Gtk.Label(label=title, xalign=0, wrap=True)
            heading.add_css_class("heading")
            box.append(heading)
            body = Gtk.Label(label=text, xalign=0, wrap=True)
            body.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            box.append(body)
            col.append(card(box))

        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(col)
        folder = Gtk.Button(label=tr("Open data folder"))
        folder.connect("clicked", lambda *_: parent.open_data_folder(None))
        full = Gtk.Button(label=tr("Read the full policy"))
        full.connect("clicked", self.on_full)
        close = Gtk.Button(label=tr("Close"))
        close.add_css_class("suggested-action")
        close.connect("clicked", lambda *_: self.close())
        bottom = Gtk.Box(spacing=8)
        for side in ("top", "bottom", "start", "end"):
            getattr(bottom, "set_margin_" + side)(12)
        bottom.append(folder)
        bottom.append(full)
        spacer = Gtk.Box(hexpand=True)
        bottom.append(spacer)
        bottom.append(close)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(scroll)
        outer.append(Gtk.Separator())
        outer.append(bottom)
        self.set_child(outer)

    def on_full(self, *_):
        try:
            open_uri(privacy_url())
        except GLib.Error:
            pass


class ChangelogWindow(Gtk.Window):
    """The full changelog; versions newer than the one last opened are marked as new."""

    def __init__(self, parent, since=None):
        super().__init__(title=tr("What's new in Sottovoce"), transient_for=parent, modal=True)
        self.set_default_size(560, 640)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for side in ("top", "bottom", "start", "end"):
            getattr(col, "set_margin_" + side)(20)
        head = Gtk.Label(label=tr("What's new in Sottovoce %s") % VERSION, xalign=0, wrap=True)
        head.add_css_class("title-2")
        col.append(head)
        if since and version_key(since) < version_key(VERSION):
            sub = tr("You updated from version %s. The changes since then are marked as new.") % since
        else:
            sub = tr("The full history of Sottovoce, newest first.")
        sub_label = Gtk.Label(label=sub, xalign=0, wrap=True)
        sub_label.add_css_class("dim-label")
        col.append(sub_label)

        for version, day, items in CHANGELOG:
            is_new = (version_key(version) > version_key(since) if since
                      else version == VERSION)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            title_row = Gtk.Box(spacing=8)
            title = Gtk.Label(label=tr("Version %s") % version, xalign=0)
            title.add_css_class("heading")
            title_row.append(title)
            if is_new:
                badge = Gtk.Label(label=tr("New"))
