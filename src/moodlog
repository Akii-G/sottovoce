DREAM_FEELINGS = [("pleasant", tr("Pleasant")), ("neutral", tr("Neutral")),
                  ("disturbing", tr("Disturbing"))]
DREAM_FEELING_LABELS = dict(DREAM_FEELINGS)
DREAM_TAGS = [("nightmare", tr("Nightmare")), ("vivid", tr("Vivid")), ("recurring", tr("Recurring")),
              ("lucid", tr("Lucid")), ("forgotten", tr("Didn't remember"))]
DREAM_TAG_LABELS = dict(DREAM_TAGS)


def clean_tags(tags):
    """Tags as one text in a fixed order ("nightmare,vivid"); unknown tags are dropped."""
    if isinstance(tags, str):
        tags = tags.replace(";", ",").split(",")
    wanted = {str(t).strip().lower() for t in tags or []}
    return ",".join(key for key, _label in DREAM_TAGS if key in wanted)


def dream_tags(dream):
    return [t for t in dream[2].split(",") if t]


class DreamStore(EventStore):
    """The dream journal: dreams.csv. A dream belongs to the morning you woke up.

    Each dream is [date, feeling, tags, text, id, updated, private], laid out like an event so
    merging, deletions and syncing work the same way. feeling is "" or a DREAM_FEELINGS
    key, tags a clean_tags() text.
    """

    def __init__(self, path=None):
        own = path or os.path.join(data_dir(), "dreams.csv")
        super().__init__(own if path is None else path)
        self.path = own   # never events.csv, even for an in-memory store (path "")

    def load(self):
        self.items = []
        self.deleted = {}
        self.mtime = file_mtime(self.path)
        if not os.path.exists(self.path):
            return
        with open(self.path, newline="", encoding="utf-8-sig") as f:
            for row in csv.DictReader(f):
                eid = (row.get("id") or "").strip()
                gone = clean_stamp(row.get("deleted"))
                if gone and eid:
                    self.deleted[eid] = gone
                    continue
                try:
                    day = dt.date.fromisoformat((row.get("date") or "").strip())
                except ValueError:
                    continue
                feeling = (row.get("feeling") or "").strip()
                feeling = feeling if feeling in DREAM_FEELING_LABELS else ""
                tags, text_ = clean_tags(row.get("tags") or ""), row.get("text") or ""
                if not (feeling or tags or text_.strip()):
                    continue
                if not eid:
                    eid = legacy_id("dream", day, feeling, tags, text_)
                self.items.append([day, feeling, tags, text_, eid, clean_stamp(row.get("updated")),
                                   truthy(row.get("private"))])
        self.sort()

    def add(self, day, feeling, tags, text_, eid=None, updated=None, private=False):
        dream = super().add(day, feeling, tags, text_, eid=eid, updated=updated)
        dream.append(bool(private))
        return dream

    def set_private(self, dream, private):
        while len(dream) < 7:
            dream.append(False)
        if dream[6] != bool(private):
            dream[6] = bool(private)
            dream[5] = now_stamp()

    def save(self):
        if self.changed_on_disk():
            self.absorb(DreamStore(self.path))
        tmp = self.path + ".tmp"
        with open(tmp, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(["date", "feeling", "tags", "text", "id", "updated", "deleted", "private"])
            for d in self.items:
                day, feeling, tags, text_, eid, updated = d[:6]
                w.writerow([day.isoformat(), feeling, tags, text_, eid, updated, "",
                            "1" if is_private(d, 6) else ""])
            for eid, gone in sorted(self.deleted.items()):
                w.writerow(["", "", "", "", eid, "", gone, ""])
        os.replace(tmp, self.path)
        self.mtime = file_mtime(self.path)

    def is_nightmare(self, dream):
        return "nightmare" in dream_tags(dream) or dream[1] == "disturbing"


def dream_title(dream):
    """A short line for lists: the start of the text, or the tags if there is none."""
    words = " ".join(dream[3].split())
    if words:
        return words if len(words) <= 90 else words[:88].rsplit(" ", 1)[0] + "\u2026"
    tags = [DREAM_TAG_LABELS[t] for t in dream_tags(dream)]
    return ", ".join(tags) if tags else DREAM_FEELING_LABELS.get(dream[1], "")


def dream_details(dream):
    """Feeling and tags as one line: "Disturbing · Nightmare, Vivid"."""
    parts = []
    if dream[1]:
        parts.append(DREAM_FEELING_LABELS[dream[1]])
    tags = [DREAM_TAG_LABELS[t] for t in dream_tags(dream)]
    if tags:
        parts.append(", ".join(tags))
    return " · ".join(parts)


def dream_stats(store, dreams, start=None, end=None):
    """Counts for a period and the mood on days after a disturbing dream vs other days."""
    items = dreams.between(start, end)
    remembered = [d for d in items if "forgotten" not in dream_tags(d) or d[3].strip()]
    bad_days = {d[0] for d in items if dreams.is_nightmare(d)}
    nights = {d[0] for d in items}
    after_bad, after_other = [], []
    for day in nights:
        avg = store.day_avg(day)
        if avg:
            (after_bad if day in bad_days else after_other).append(avg)
    mean = (lambda v: sum(v) / len(v) if v else 0.0)
    return {"nights": len(nights), "dreams": len(remembered), "nightmares": len(bad_days),
            "pleasant": len({d[0] for d in items if d[1] == "pleasant"}),
            "after_bad": (mean(after_bad), len(after_bad)),
            "after_other": (mean(after_other), len(after_other))}


def draw_flag(cr, px, top, h, color, alpha=1.0):
    """A small flag: a pole at px from top to top + h, with the cloth to the right."""
    src(cr, color, alpha)
    cr.set_line_width(max(1.2, h * 0.12))
    cr.set_line_cap(1)
    cr.move_to(px, top + h)
    cr.line_to(px, top)
    cr.stroke()
    cr.move_to(px, top)
    cr.line_to(px + h * 0.72, top + h * 0.27)
    cr.line_to(px, top + h * 0.55)
    cr.close_path()
    cr.fill()


def draw_event_badge(cr, cx, cy, r, th):
    """Round badge with a flag, readable on any mood colour."""
    src(cr, th["surface"])
    cr.arc(cx, cy, r, 0, 2 * math.pi)
    cr.fill()
    src(cr, th["ink"], 0.3)
    cr.set_line_width(1)
    cr.arc(cx, cy, r - 0.5, 0, 2 * math.pi)
    cr.stroke()
    h = r * 1.15
    draw_flag(cr, cx - h * 0.3, cy - h / 2, h, th["ink"])


def draw_moon(cr, cx, cy, r, color, alpha=1.0):
    """A crescent moon: a disc with a smaller, offset disc cut out of it."""
    cr.push_group()
    src(cr, color, alpha)
    cr.arc(cx, cy, r, 0, 2 * math.pi)
    cr.fill()
    cr.set_operator(0)  # CLEAR
    cr.arc(cx + r * 0.48, cy - r * 0.32, r * 0.82, 0, 2 * math.pi)
    cr.fill()
    cr.pop_group_to_source()
    cr.paint()


def draw_dream_badge(cr, cx, cy, r, th):
    """Round badge with a moon, readable on any mood colour (like the event badge)."""
    src(cr, th["surface"])
    cr.arc(cx, cy, r, 0, 2 * math.pi)
    cr.fill()
    src(cr, th["ink"], 0.3)
    cr.set_line_width(1)
    cr.arc(cx, cy, r - 0.5, 0, 2 * math.pi)
    cr.stroke()
    draw_moon(cr, cx - r * 0.08, cy + r * 0.05, r * 0.58, th["ink"])


def draw_event_lines(widget, cr, w, top, bottom, th, n, slot):
    """Dashed line and flag at each event in the period on a time chart."""
    win = widget.win
    start, end = win.period()
    groups = {}
    for event in win.events.between(start, end):
        i = slot(event[0])
        if i is not None:
            groups.setdefault(i, []).append(event)
    for i, events in sorted(groups.items()):
        x = round(slot_x(i, n, w)) + 0.5
        src(cr, th["ink2"], 0.6)
        cr.set_line_width(1)
        cr.set_dash([3, 3])
        cr.move_to(x, top)
        cr.line_to(x, bottom)
        cr.stroke()
        cr.set_dash([])
        draw_flag(cr, x, top - 11, 10, th["ink2"])
        widget.hits.append((x - 7, top - 13, 14, bottom - top + 13,
                            "\n".join(event_line(e) for e in events)))


