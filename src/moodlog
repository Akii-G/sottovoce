        close.connect("clicked", lambda *_: self.close())
        col.append(close)
        self.set_child(col)
        self.update(fields=True)

    def update(self, fields=False):
        store, appt, today = self.win.appointment, self.win.appointment.appt, dt.date.today()
        if fields:
            self.date_entry.set_text(appt["date"].isoformat() if appt["date"] else "")
            self.time_entry.set_text(appt["time"])
            self.with_entry.set_text(appt["with"])
        self.clear_b.set_visible(bool(appt["date"]))
        self.recap.set_text(appointment_recap(self.win.store, self.win.events, store.recap_start(today), today))
        child = self.list.get_first_child()
        while child:
            self.list.remove(child)
            child = self.list.get_first_child()
        for point in sorted(store.points, key=lambda p: (p["done"], p["updated"])):
            row = Gtk.Box(spacing=8)
            for side in ("top", "bottom", "start", "end"):
                getattr(row, "set_margin_" + side)(8)
            check = Gtk.CheckButton(active=point["done"], valign=Gtk.Align.START)
            check.set_tooltip_text(tr("Said it"))
            check.connect("toggled", self.on_done, point)
            label = Gtk.Label(label=point["text"], xalign=0, wrap=True, hexpand=True)
            label.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            if point["done"]:
                label.add_css_class("dim-label")
            remove = Gtk.Button.new_from_icon_name("user-trash-symbolic")
            remove.add_css_class("flat")
            remove.set_valign(Gtk.Align.START)
            remove.set_tooltip_text(tr("Delete"))
            remove.connect("clicked", self.on_remove, point)
            row.append(check)
            row.append(label)
            row.append(remove)
            self.list.append(row)
        self.list.set_visible(bool(store.points))

    def on_save_date(self, *_):
        raw = self.date_entry.get_text().strip()
        try:
            day = dt.date.fromisoformat(raw)
        except ValueError:
            self.error.set_text(tr("Write the date as year-month-day, for example %s.") % dt.date.today().isoformat())
            self.error.set_visible(True)
            return
        time = self.time_entry.get_text().strip()
        if time and not TIME_RE.match(time):
            self.error.set_text(tr("Write the time as hours:minutes, for example 16:30."))
            self.error.set_visible(True)
            return
        self.error.set_visible(False)
        self.win.appointment.set_appointment(day, time, " ".join(self.with_entry.get_text().split()))
        self.win.save_appointment()
        self.win.notify(tr("Appointment saved"))

    def on_clear(self, *_):
        self.win.appointment.set_appointment(None)
        self.win.save_appointment()
        self.update(fields=True)

    def on_add(self, *_):
        text_ = " ".join(self.point_entry.get_text().split())
        if not text_:
            return
        self.win.appointment.add_point(text_)
        self.point_entry.set_text("")
        self.win.save_appointment()

    def on_done(self, check, point):
        self.win.appointment.set_done(point, check.get_active())
        GLib.idle_add(lambda: self.win.save_appointment() and False)

    def on_remove(self, _b, point):
        self.win.appointment.remove_point(point)
        GLib.idle_add(lambda: self.win.save_appointment() and False)


