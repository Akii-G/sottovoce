        if os.environ.get("MOODLOG_NO_WHATS_NEW"):  # used by the tests
            return False
        cfg = load_config()
        seen = cfg.get("last_seen_version")
        if seen == VERSION:
            return False
        has_data = bool(self.store.days or self.events.items)
        cfg["last_seen_version"] = VERSION
        try:
            save_config(cfg)
        except OSError:
            pass
        if seen is not None or has_data:  # an update, also from versions before 2.1
            ChangelogWindow(self, since=seen).present()
            if not cfg.get("customize_seen"):     # once, for people who saw the tour before 2.9
                cfg["customize_seen"] = True
                try:
                    save_config(cfg)
                except OSError:
                    pass
                CustomizeWindow(self).present()
        elif not cfg.get("tour_done"):    # a brand-new install: show the welcome tour
            self.start_tour()
        return False

    def start_tour(self):
        if self.tour is not None:
            return
        self.stack.set_visible_child_name("log")
        self.tour = TourOverlay(self, self.end_tour)
        self.tour_root.add_overlay(self.tour)

    def connect_pref(self, key, callback):
        """Call callback(value) whenever that preference changes."""
        self._pref_listeners = getattr(self, "_pref_listeners", [])
        self._pref_listeners.append((key, callback))

    def set_pref(self, key, value):
        if self.prefs.get(key) == value:
            return
        self.prefs[key] = value
        for k, callback in getattr(self, "_pref_listeners", []):
            if k == key:
                try:
                    callback(value)
                except Exception:   # a widget that's gone: ignore
                    pass
        cfg = load_config()
        cfg["prefs"] = dict(self.prefs)
        try:
            save_config(cfg)
        except OSError:
            pass
        self.apply_prefs()

    def apply_prefs(self):
        """Show or hide the parts turned on or off in Customize."""
        page = self.stack.get_page(self.stack.get_child_by_name("dreams"))
        if page is not None:
            page.set_visible(bool(self.prefs["dreams"]))
        if not self.prefs["dreams"] and self.stack.get_visible_child_name() == "dreams":
            self.stack.set_visible_child_name("log")
        self.private_check.set_visible(bool(self.prefs["private_tick"]))
        self.feel_row.set_visible(bool(self.prefs["feelings"]))
        self.act_row.set_visible(bool(self.prefs["activities"]))
        self.update_prompt()
        self.survey_menu.remove_all()
        if self.prefs["questionnaires"]:
            self.survey_menu.append(tr("Questionnaires for your doctor…"), "win.questionnaires")
        self.refresh_surveys()
        self.rebuild_day_events()
        self.rebuild_entries()
        self.redraw_all()

    def end_tour(self):
        if self.tour is None:
            return
        self.tour_root.remove_overlay(self.tour)
        self.tour = None
        cfg = load_config()
        cfg["tour_done"] = True
        cfg["customize_seen"] = True
        try:
            save_config(cfg)
        except OSError:
            pass

