    def _pick(self, title, mode, callback, name=None):
        """File or folder picker that works on old and new GTK 4. mode: save, open, folder."""
        if hasattr(Gtk, "FileDialog"):
            dialog = Gtk.FileDialog(title=title)
            if name:
                dialog.set_initial_name(name)
            start = {"save": dialog.save, "open": dialog.open, "folder": dialog.select_folder}[mode]
            finish = {"save": dialog.save_finish, "open": dialog.open_finish,
                      "folder": dialog.select_folder_finish}[mode]

            def done(_d, result):
                try:
                    gfile = finish(result)
                except GLib.Error:
                    return
                if gfile and gfile.get_path():
                    callback(gfile.get_path())
            start(self, None, done)
            return
        action = {"save": Gtk.FileChooserAction.SAVE, "open": Gtk.FileChooserAction.OPEN,
                  "folder": Gtk.FileChooserAction.SELECT_FOLDER}[mode]
        chooser = Gtk.FileChooserNative.new(title, self, action, None, None)
        if name:
            chooser.set_current_name(name)

        def response(dialog, code):
            if code == Gtk.ResponseType.ACCEPT and dialog.get_file():
                callback(dialog.get_file().get_path())
            self._chooser = None
        chooser.connect("response", response)
        self._chooser = chooser
        chooser.show()

    def ask_folder(self, title, callback):
        self._pick(title, "folder", callback)

    def on_backup(self):
        self.flush()

        def write(path):
            if not path.lower().endswith(".zip"):
                path += ".zip"
            try:
                names = make_backup(path)
                self.notify(trn("Backed up %d file to %s", "Backed up %d files to %s", len(names)) % (
                    len(names), os.path.basename(path)))
            except OSError as err:
                self.notify(tr("Could not back up: %s") % (err.strerror or err))
        self._pick(tr("Back up Sottovoce"), "save", write,
                   "sottovoce-backup-%s.zip" % dt.date.today().isoformat())

    def on_restore(self):
        self.flush()

        def chosen(path):
            try:
                _files, info = read_backup(path)
            except BackupError as err:
                self.notify(str(err))
                return
            made = info.get("created") or tr("an unknown date")
            ConfirmWindow(self, tr("Restore this backup?"), (
                tr("Your current moods, events and health data will be replaced by the ones in "
                "the backup from %s. A copy of your current data is saved first, in the "
                "backups folder inside your data folder.") % made),
                [(tr("Restore"), lambda: self.do_restore(path), "destructive-action")]).present()
        self._pick(tr("Restore from a backup"), "open", chosen)

    def do_restore(self, path):
        try:
            safety = restore_backup(path)
        except (BackupError, OSError) as err:
            self.notify(tr("Could not restore: %s") % err)
            return
        self.reload_data()
        self.notify(tr("Backup restored. Your previous data was saved as %s") % os.path.basename(safety))

    def merge_conflict_copies(self):
        self.flush()
        try:
            files, added = merge_conflicts(self.store, self.events, self.health, self.dreams)
        except OSError as err:
            self.notify(tr("Could not merge: %s") % (err.strerror or err))
            return
        self.reload_data()
        self.banner.set_visible(False)
        if files:
            self.notify((trn("Merged %d conflict copy", "Merged %d conflict copies", files) % files + ": "
                         + trn("%d item added.", "%d items added.", added) % added + " "
                         + tr("The copies were moved to backups/merged-conflicts.")))

    def reload_data(self):
        """Read every data file again (after a restore, a folder change or a sync)."""
        index = None
        if self.current is not None:
            items = self.store.entries(self.selected)
            index = next((i for i, e in enumerate(items) if e is self.current), None)
        self.store = Store()
        self.events = EventStore()
        self.dreams = DreamStore()
        self.health = HealthStore()
        self.meds = Medication()
        self.surveys = SurveyStore()
        self.refresh_surveys()
        self.appointment = AppointmentStore()
        self.refresh_appointment()
        self.link.store = self.store
        items = self.store.entries(self.selected)
        self.current = items[index] if index is not None and index < len(items) else None
        self.load_selected(self.current)
        self.redraw_all()
        self.refresh()

    def open_data_folder(self, _btn):
        self.flush()
        open_uri(GLib.filename_to_uri(data_dir(), None))

    # -- refresh

    def redraw_all(self):
        def walk(widget):
            if isinstance(widget, Gtk.DrawingArea):
                widget.queue_draw()
            child = widget.get_first_child()
            while child:
                walk(child)
                child = child.get_next_sibling()
        walk(self)

    def streak(self):
        day = dt.date.today()
        if not self.store.day_level(day):
            day -= dt.timedelta(days=1)
        count = 0
        while self.store.day_level(day):
            count += 1
            day -= dt.timedelta(days=1)
        return count

    def refresh(self):
        cur, today = self.cursor, dt.date.today()
        at_now = (cur.year, cur.month) >= (today.year, today.month)
        self.month_label.set_text("%s %d" % (MONTHS[cur.month - 1], cur.year))
        self.log_next.set_sensitive(not at_now)
        last = calendar.monthrange(cur.year, cur.month)[1]
        month_moods = [m for _d, m in self.store.moods(cur, cur.replace(day=last))]
        if month_moods:
            avg = sum(month_moods) / len(month_moods)
            self.month_summary.set_text(trn("%d day logged this month · average %.1f (%s)",
                "%d days logged this month · average %.1f (%s)", len(month_moods)) % (
                len(month_moods), avg,
                MOOD_NAMES[to_level(avg)].lower()))
        else:
            self.month_summary.set_text(tr("Nothing logged this month yet"))
        self.calendar.queue_draw()
        self.refresh_kind_word()
        self.refresh_appointment()

        visible = self.stack.get_visible_child_name()
        if visible == "charts":
            self.refresh_charts()
        elif visible == "notes":
            self.refresh_notes()
        elif visible == "events":
            self.refresh_events()
        elif visible == "dreams":
            self.refresh_dreams()

    def refresh_charts(self):
        cur, today, mode = self.cursor, dt.date.today(), self.range_mode
        if mode == "month":
            self.period_label.set_text("%s %d" % (MONTHS[cur.month - 1], cur.year))
            at_now = (cur.year, cur.month) >= (today.year, today.month)
            days_total = calendar.monthrange(cur.year, cur.month)[1]
            if at_now:
                days_total = today.day
            self.trend_title.set_text(tr("Mood day by day"))
        elif mode == "year":
            self.period_label.set_text(str(cur.year))
            at_now = cur.year >= today.year
            end = today if at_now else dt.date(cur.year, 12, 31)
            days_total = (end - dt.date(cur.year, 1, 1)).days + 1
            self.trend_title.set_text(tr("Average mood by month"))
        else:
            self.period_label.set_text(tr("All time"))
            at_now = True
            first = min(self.store.days) if self.store.days else today
            days_total = (today - first).days + 1
            self.trend_title.set_text(tr("Average mood by month"))
        self.chart_prev.set_visible(mode != "all")
        self.chart_next.set_visible(mode != "all")
        self.chart_next.set_sensitive(not at_now)

        moods = [m for _d, m in self.period_moods()]
        value, sub = self.tiles["avg"]
        if moods:
            avg = sum(moods) / len(moods)
            value.set_text("%.1f" % avg)
            sub.set_text(tr("%s, on a 1–5 scale") % MOOD_NAMES[to_level(avg)])
        else:
            value.set_text("–")
            sub.set_text(tr("nothing logged"))
        value, sub = self.tiles["days"]
        value.set_text(str(len(moods)))
        sub.set_text(trn("of %d day so far", "of %d days so far", days_total) % days_total)
        value, sub = self.tiles["common"]
        # every entry counts, like the "How often you logged each mood" chart (and the phones)
        logged = [m for _d, _t, m in self.period_entries() if m]
        if logged:
            best = max(range(1, 6), key=lambda m: (logged.count(m), m))
            value.set_text(MOOD_NAMES[best])
            n = logged.count(best)
            sub.set_text(trn("%d of %d entry", "%d of %d entries", len(logged)) % (n, len(logged)))
        else:
            value.set_text("–")
            sub.set_text("")
        value, sub = self.tiles["streak"]
        streak = self.streak()
        value.set_text(trn("%d day", "%d days", streak) % streak)
        sub.set_text(tr("logged in a row, up to today"))
        for chart in (self.trend, self.counts, self.weekdays, self.hours, self.scales):
            chart.queue_draw()
        dreams = dream_summary_text(self.store, self.dreams, *self.period())
        self.chart_dreams.set_text(dreams or "")
        self.chart_dreams_card.set_visible(bool(dreams))
        self.refresh_health()

    def refresh_notes(self):
        child = self.notes_list.get_first_child()
        while child:
            self.notes_list.remove(child)
            child = self.notes_list.get_first_child()
        query = self.search.get_text().strip()
        results = search_results(self.store, self.events, query)
        for kind, day, item in results[:300]:          # enough to read; a narrower search finds the rest
            row = Gtk.ListBoxRow()
            row.day, row.kind, row.item = day, kind, item
            box = Gtk.Box(spacing=12)
            for side in ("top", "bottom", "start", "end"):
                getattr(box, "set_margin_" + side)(12)
            textbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
            when = fmt_date(day, tr("%A, %-d %B %Y"))
            if kind == "entry":
                time, mood, note = item[:3]
                if mood:
                    icon = FaceIcon(mood, 34, badge=True)
                    icon.set_valign(Gtk.Align.START)
                    icon.set_tooltip_text(MOOD_NAMES[mood])
                    box.append(icon)
                else:
                    spacer = Gtk.Box()
                    spacer.set_size_request(34, 34)
                    box.append(spacer)
                if time:
                    when += " · " + time
                if mood:
                    when += " · " + MOOD_NAMES[mood]
                lines = [note.strip()] if note.strip() else []
                feelings = feelings_text(entry_feelings(item))
                if feelings and (not lines or find_matches(feelings, query)):
                    lines.append(feelings)
                did = activities_text(entry_activities(item))
                if did and (not lines or find_matches(did, query)):
                    lines.append(did)
            else:
                icon = EventIcon(34)
                icon.set_valign(Gtk.Align.START)
                box.append(icon)
                when += " · " + EVENT_LABELS[item[1]]
                lines = [item[2]] + ([item[3].strip()] if item[3].strip() else [])
            head = Gtk.Label(label=when, xalign=0)
            head.add_css_class("heading")
            textbox.append(head)
            for k, line in enumerate(lines):
                body = Gtk.Label(xalign=0, wrap=True)
                body.set_markup(marked(line, query))
                body.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                if kind == "entry" and k > 0:
                    body.add_css_class("dim-label")
                textbox.append(body)
            box.append(textbox)
            row.set_child(box)
            self.notes_list.append(row)
        shown = len(results)
        self.notes_list.set_visible(shown > 0)
        self.notes_empty.set_visible(shown == 0)
        if query:
            self.notes_empty.set_text(tr("Nothing matches “%s”.") % query)
        else:
            self.notes_empty.set_text(
                tr("No notes yet.\nAdd a few words when you log a mood and they will show up here."))

def center_window_dots(widget):
    """The close, minimize and maximize buttons keep their own height in the middle of the title
    bar. Some GTK versions (Windows) stretch them to the bar's full height, and the round Tahoe
    dots become tall pills."""
    if isinstance(widget, Gtk.WindowControls):
        child = widget.get_first_child()
        while child is not None:
            child.set_valign(Gtk.Align.CENTER)
            child = child.get_next_sibling()
        widget.set_valign(Gtk.Align.CENTER)
        return
    child = widget.get_first_child()
    while child is not None:
        center_window_dots(child)
        child = child.get_next_sibling()


def dump_widgets(widget, depth=0, only=None):
    """For bug hunting (MOODLOG_DUMP_TITLEBAR): each widget's CSS name, classes and size;
    with `only`, just the subtrees whose CSS name is that."""
    if only and widget.get_css_name() != only:
        child = widget.get_first_child()
        while child is not None:
            dump_widgets(child, depth, only)
            child = child.get_next_sibling()
        return True
    _m, nat_h, _b, _b2 = widget.measure(Gtk.Orientation.VERTICAL, -1)
    print("%s%s %s %dx%d nat_h=%d valign=%s" % ("  " * depth, widget.get_css_name(), widget.get_css_classes(),
                                                 widget.get_width(), widget.get_height(), nat_h,
                                                 widget.get_valign().value_nick), file=sys.stderr, flush=True)
    child = widget.get_first_child()
    while child is not None:
        dump_widgets(child, depth + 1)
        child = child.get_next_sibling()
    return True


def watch_window_dots():
    """Runs center_window_dots on every window when it appears, and again when the layout of the
    title-bar buttons changes."""
    seen = set()

    def fix(win):
        # the title bar may be the window's titlebar or (Adwaita) inside its content: walk it all
        center_window_dots(win)
        if os.environ.get("MOODLOG_DUMP_TITLEBAR"):
            GLib.timeout_add(2500, lambda: dump_widgets(win, only="windowcontrols") and False)
        return False

    def hook(model, _pos=0, _removed=0, _added=0):
        for i in range(model.get_n_items()):
            win = model.get_item(i)
            if id(win) not in seen:
                seen.add(id(win))
                win.connect("map", lambda w: GLib.idle_add(fix, w))
            GLib.idle_add(fix, win)
    windows = Gtk.Window.get_toplevels()
    windows.connect("items-changed", hook)
    hook(windows)
    settings = Gtk.Settings.get_default()
    if settings is not None:
        settings.connect("notify::gtk-decoration-layout",
                         lambda *_: [GLib.idle_add(fix, windows.get_item(i)) for i in range(windows.get_n_items())])


class App(Adw.Application):
    def __init__(self, page=None):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.page = page
        self.restart = False   # set when the language changes: main() starts Moodlog again

    def do_activate(self):
        if not self.get_active_window():
            apply_style(load_config().get("style", default_style()))
            watch_window_dots()
            if IS_MAC:
                import threading
                threading.Thread(target=mac_refresh_agents, daemon=True).start()
        win = self.get_active_window() or Window(self, self.page)
        win.present()


def diag(path):
    """`moodlog --diag FILE`: starts GTK step by step and writes each step to FILE, to see
    where a crash happens on a new system."""
    out = open(path, "w")

    def step(text):
        out.write(text + "\n")
        out.flush()
        os.fsync(out.fileno())
    for key in ("GTK_DATA_PREFIX", "GTK_EXE_PREFIX", "GDK_PIXBUF_MODULE_FILE", "GI_TYPELIB_PATH",
                "XDG_DATA_DIRS", "GSETTINGS_SCHEMA_DIR", "GSK_RENDERER", "GIO_MODULE_DIR"):
        step("%s=%s" % (key, os.environ.get(key)))
    step("gtk init")
    Gtk.init()
    step("display %s" % Gdk.Display.get_default())
    step("adw init")
    Adw.init()
    step("style manager %s" % Adw.StyleManager.get_default().get_dark())
    step("icon theme")
    theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
    step("has edit-copy-symbolic: %s" % theme.has_icon("edit-copy-symbolic"))
    step("window")
    win = Gtk.Window(title="diag")
    win.set_child(Gtk.Label(label="Sottovoce"))
    step("present")
    win.present()
    loop = GLib.MainLoop()
    GLib.timeout_add(1500, loop.quit)
    step("loop")
    loop.run()
    step("adw application")
    app = Adw.Application(application_id=APP_ID + ".Diag")
    app.connect("activate", lambda a: (step("activated"), a.quit()))
    app.run([])
    step("done with the basics; now Sottovoce itself, logging each call")
    me = os.path.basename(__file__) if "__file__" in globals() else "moodlog"

    def prof(frame, event, _arg):
        if event == "call" and frame.f_code.co_filename.endswith(me):
            out.write("%s:%d %s\n" % (frame.f_code.co_name, frame.f_lineno, ""))
            out.flush()
        elif event == "c_call":
            out.write("  c %s\n" % getattr(_arg, "__qualname__", _arg))
            out.flush()
    sys.setprofile(prof)
    real = App(None)
    GLib.timeout_add(4000, lambda: real.quit())
    real.run([sys.argv[0]])
    sys.setprofile(None)
    step("Sottovoce ran and quit")
    return 0


def main(argv):
    if sys.stdout is None or sys.stderr is None:
        # the Windows .exe has no console: messages go to a small log, for bug reports
        try:
            path = os.path.join(config_dir(), "moodlog.log")
            if os.path.exists(path) and os.path.getsize(path) > 512 * 1024:
                os.replace(path, path + ".old")
            log = open(path, "a", encoding="utf-8", buffering=1)
        except OSError:
            log = open(os.devnull, "w")
        sys.stdout = sys.stdout or log
        sys.stderr = sys.stderr or log

    if IS_WINDOWS:
        try:
            import faulthandler
            faulthandler.enable(sys.stderr)     # a crash leaves its Python stack in the log
        except (ValueError, OSError, RuntimeError, AttributeError):
            pass
    if os.environ.get("MOODLOG_TRACE"):
        # for bug hunting: the Python stack every half second, and on a crash
        import faulthandler
        global _trace_file
        _trace_file = open(os.environ["MOODLOG_TRACE"], "w")
        faulthandler.enable(_trace_file, all_threads=True)
        faulthandler.dump_traceback_later(0.5, repeat=True, file=_trace_file)
    if "--diag" in argv:
        return diag(argv[argv.index("--diag") + 1])
    if "--version" in argv:
        print("Sottovoce", VERSION)
        return 0
    if "--remind" in argv:
        mac_hide_from_dock()      # again: GTK may have made it a Dock app while starting
        return remind()
    if "--sync-server" in argv:
        mac_hide_from_dock()
        return run_sync_server()
    if "--resume-sync" in argv:
        return resume_receiver()
    if "--changelog" in argv:
        print(changelog_markdown())
        return 0
    if "--report" in argv:
        i = argv.index("--report")
        opts = dict(zip(argv[1::1], argv[2::1]))
        end = dt.date.fromisoformat(opts["--to"]) if "--to" in opts else dt.date.today()
        start = dt.date.fromisoformat(opts["--from"]) if "--from" in opts else end - dt.timedelta(days=90)
        pages = export_report(argv[i + 1], Store(), EventStore(), HealthStore(), start, end,
                              include_notes="--notes" in argv, dreams=DreamStore(),
                              dream_mode="text" if "--dream-text" in argv else
                              "summary" if "--dreams" in argv else "off")
        print("Saved a %d-page report to %s" % (pages, argv[i + 1]))
        return 0
    if "--export" in argv:
        i = argv.index("--export")
        if i + 1 >= len(argv):
            print("usage: moodlog --export FILE.csv|FILE.xlsx", file=sys.stderr)
            return 2
        writer = export_xlsx if argv[i + 1].lower().endswith(".xlsx") else export_csv
        try:
            count = writer(argv[i + 1], Store(), EventStore(), HealthStore(), DreamStore())
        except ExportError as err:
            print(err, file=sys.stderr)
            return 1
        print("Exported %d days to %s" % (count, argv[i + 1]))
        return 0
    page = None
    for arg in argv[1:]:
        if arg.startswith("--page="):
            page = arg.split("=", 1)[1]
    app = App(page)
    status = app.run([argv[0]])
    if app.restart:
        restart_self([a for a in argv[1:] if not a.startswith("moodlog:")])
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv))
