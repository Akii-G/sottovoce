def reminder_settings(cfg=None):
    r = (cfg or load_config()).get("reminder") or {}
    time = r.get("time", "20:30")
    if not re.match(r"^([01]\d|2[0-3]):[0-5]\d$", time):
        time = "20:30"
    return bool(r.get("on")), time


def timer_text(time):
    return ("[Unit]\nDescription=Sottovoce daily reminder at %s\n\n"
            "[Timer]\nOnCalendar=*-*-* %s:00\nAccuracySec=1min\n\n"
            "[Install]\nWantedBy=timers.target\n" % (time, time))


def apply_reminder(on, time):
    """Saves the choice and (re)installs the systemd user timer. Returns (ok, error)."""
    cfg = load_config()
    cfg["reminder"] = {"on": bool(on), "time": time}
    save_config(cfg)
    if IS_WINDOWS:
        return win_apply_reminder(on, time)
    if IS_MAC:
        return mac_apply_reminder(on, time)
    unit_dir = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "systemd", "user")
    path = os.path.join(unit_dir, REMINDER_TIMER)
    if not on:
        ok, err = systemctl("disable", "--now", REMINDER_TIMER)
        try:
            os.remove(path)
        except OSError:
            pass
        systemctl("daemon-reload")
        return True, ""
    os.makedirs(unit_dir, exist_ok=True)
    with open(path, "w") as f:
        f.write(timer_text(time))
    systemctl("daemon-reload")
    ok, err = systemctl("enable", "--now", REMINDER_TIMER)
    if ok:
        systemctl("restart", REMINDER_TIMER)    # picks up a changed time
    return ok, err


def remind():
    """`moodlog --remind` (run by the timer): one quiet desktop notification, only if
    nothing is logged today. Clicking it opens Moodlog."""
    on, _time = reminder_settings()
    if not on or Store().day_avg(dt.date.today()):
        return 0
    if IS_WINDOWS or IS_MAC:
        ok, err = (win_toast if IS_WINDOWS else mac_notify)(tr("How are you today?"), tr("One click on a face is enough."))
        if not ok:
            print("moodlog: could not show the reminder (%s)" % err, file=sys.stderr)
        return 0 if ok else 1
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        reply = bus.call_sync(
            "org.freedesktop.Notifications", "/org/freedesktop/Notifications", "org.freedesktop.Notifications",
            "Notify", GLib.Variant("(susssasa{sv}i)", (
                "Sottovoce", 0, APP_ID, tr("How are you today?"), tr("One click on a face is enough."),
                ["default", tr("Open Sottovoce")],
                {"desktop-entry": GLib.Variant("s", APP_ID), "urgency": GLib.Variant("y", 1)}, -1)),
            GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 10000, None)
    except GLib.Error as err:
        print("moodlog: could not show the reminder (%s)" % err.message, file=sys.stderr)
        return 1
    note_id = reply.unpack()[0]
    loop = GLib.MainLoop()

    def on_signal(_conn, _sender, _path, _iface, signal, params):
        args = params.unpack()
        if args[0] != note_id:
            return
        if signal == "ActionInvoked":
            subprocess.Popen(self_command(), start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        loop.quit()

    for name in ("ActionInvoked", "NotificationClosed"):
        bus.signal_subscribe("org.freedesktop.Notifications", "org.freedesktop.Notifications", name,
                             "/org/freedesktop/Notifications", None, Gio.DBusSignalFlags.NONE, on_signal)
    GLib.timeout_add_seconds(3600, loop.quit)    # stop waiting after an hour
    loop.run()
    return 0




# ----------------------------------------------------------------- Mac
# On a Mac there is no systemd either: the phone receiver and the daily reminder are launchd
# agents in ~/Library/LaunchAgents (the receiver starts at login and is kept running), and the
# reminder is a notification from macOS. Everything else is the same app.
MAC_SYNC_LABEL = "app.moodlog.Sottovoce.sync"
MAC_REMIND_LABEL = "app.moodlog.Sottovoce.reminder"


def mac_agent_path(label):
    return os.path.expanduser("~/Library/LaunchAgents/%s.plist" % label)


def mac_launchctl(*args):
    try:
        done = subprocess.run(["launchctl"] + list(args), capture_output=True, text=True, timeout=20)
        return done.returncode == 0, (done.stderr or done.stdout).strip()
    except (OSError, subprocess.SubprocessError) as err:
        return False, str(err)


def mac_domain():
    return "gui/%d" % os.getuid()


def mac_agent_on(label, args, extra):
    """Writes the launchd agent that runs Sottovoce with `args`, and (re)loads it."""
    import plistlib
    path = mac_agent_path(label)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    log = os.path.join(config_dir(), label.rsplit(".", 1)[-1] + ".log")
    agent = {"Label": label, "ProgramArguments": self_command(*args), "ProcessType": "Background",
             "StandardOutPath": log, "StandardErrorPath": log}
    # a data or settings folder set for this run (tests, a second diary) goes with it
    env = {k: os.environ[k] for k in ("MOODLOG_DATA_DIR", "MOODLOG_CONFIG_DIR", "MOODLOG_LANG", "DOSE_DATA_DIR")
           if os.environ.get(k)}
    if env:
        agent["EnvironmentVariables"] = env
    agent.update(extra)
    with open(path, "wb") as f:
        plistlib.dump(agent, f)
    mac_launchctl("bootout", "%s/%s" % (mac_domain(), label))
    return mac_launchctl("bootstrap", mac_domain(), path)


def mac_agent_off(label):
    mac_launchctl("bootout", "%s/%s" % (mac_domain(), label))
    try:
        os.remove(mac_agent_path(label))
    except OSError:
        pass
    return True, ""


def mac_agent_args(label):
    import plistlib
    try:
        with open(mac_agent_path(label), "rb") as f:
            return plistlib.load(f).get("ProgramArguments")
    except (OSError, ValueError, plistlib.InvalidFileException):
        return None


def mac_agent_loaded(label, running=False):
    ok, out = mac_launchctl("print", "%s/%s" % (mac_domain(), label))
    return ok and (not running or "state = running" in out)


def mac_refresh_agents():
    """Sottovoce may have moved (a new version dragged to Applications): point the agents
    that are on at this copy. Only when something changed, since reloading stops the
    receiver for a moment. Runs in a thread: launchctl can take seconds."""
    if os.path.exists(mac_agent_path(MAC_SYNC_LABEL)) and (
            mac_agent_args(MAC_SYNC_LABEL) != self_command("--sync-server")
            or not mac_agent_loaded(MAC_SYNC_LABEL, running=True)):
        mac_agent_on(MAC_SYNC_LABEL, ["--sync-server"], {"RunAtLoad": True, "KeepAlive": True})
    on, time = reminder_settings()
    if on and os.path.exists(mac_agent_path(MAC_REMIND_LABEL)) and (
            mac_agent_args(MAC_REMIND_LABEL) != self_command("--remind")
            or not mac_agent_loaded(MAC_REMIND_LABEL)):
        mac_apply_reminder(True, time)


def mac_apply_reminder(on, time):
    if not on:
        return mac_agent_off(MAC_REMIND_LABEL)
    hour, minute = (int(x) for x in time.split(":"))
    return mac_agent_on(MAC_REMIND_LABEL, ["--remind"],
                        {"StartCalendarInterval": {"Hour": hour, "Minute": minute}})


def mac_notify(title, body):
    """A macOS notification, through AppleScript: the simplest way that works for an app that
    isn't signed by Apple (macOS shows it as coming from Script Editor)."""
    def q(text):
        return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'
    try:
        done = subprocess.run(["osascript", "-e", "display notification %s with title %s" % (q(body), q(title))],
                              capture_output=True, text=True, timeout=20)
        return done.returncode == 0, done.stderr.strip()
    except (OSError, subprocess.SubprocessError) as err:
        return False, str(err)


def open_uri(uri):
