    def update_hints(self):
        win = self.win
        short = win.health.short_nights()
        self.nights_text.set_text(trn("%d night under 4 hours: were you wearing your watch?",
                                      "%d nights under 4 hours: were you wearing your watch?", len(short)) % len(short))
        self.nights_row.set_visible(self.health_check.get_visible() and self.health_check.get_active()
                                    and bool(short))
        groups = win.meds.suggestions()
        combined = len(set(win.meds.same.values()))
        if groups:
            text = trn("%d medicine seems to appear under more than one name.",
                       "%d medicines seem to appear under more than one name.", len(groups)) % len(groups)
        elif combined:
            text = trn("%d medicine renamed.", "%d medicines renamed.", combined) % combined
        else:
            text = tr("One medicine logged under different names? Give it one name.")
        self.names_text.set_text(text)
        self.names_row.set_visible(self.meds_check.get_visible() and self.meds_check.get_active())

    def preset(self, span):
        today = dt.date.today()
        if span == "year":
            start = dt.date(today.year, 1, 1)
        elif span == "all":
            known = list(self.win.store.days) + [e[0] for e in self.win.events.items]
            start = min(known) if known else today
        else:
            start = today - dt.timedelta(days=span - 1)
        self.start_entry.set_text(start.isoformat())
        self.end_entry.set_text(today.isoformat())
        self.error.set_visible(False)

    def dates(self):
        try:
            start = dt.date.fromisoformat(self.start_entry.get_text().strip())
            end = dt.date.fromisoformat(self.end_entry.get_text().strip())
        except ValueError:
            self.error.set_text(tr("Write both dates as year-month-day, for example %s.")
                                % dt.date.today().isoformat())
            self.error.set_visible(True)
            return None
        if end < start:
            self.error.set_text(tr("The end date is before the start date."))
            self.error.set_visible(True)
            return None
        if (end - start).days > 3 * 366:
            self.error.set_text(tr("Choose at most three years."))
            self.error.set_visible(True)
            return None
        self.error.set_visible(False)
        return start, end

    def on_save(self, *_):
        period = self.dates()
        if not period:
            return
        start, end = period
        name = "sottovoce-report-%s-to-%s.pdf" % (start.isoformat(), end.isoformat())
        self.win._pick(tr("Save the report"), "save", lambda path: self.write(path, start, end), name)

    def write(self, path, start, end):
        if not path.lower().endswith(".pdf"):
            path += ".pdf"
        win = self.win
        win.flush()
        try:
            pages = export_report(path, win.store, win.events, win.health, start, end,
                                  include_notes=self.notes_check.get_active(),
                                  include_health=self.health_check.get_active(),
                                  meds=win.meds if self.meds_check.get_active() else None,
                                  surveys=win.surveys if self.surveys_check.get_active() else None,
                                  dreams=win.dreams, dream_mode=(
                                      "off" if not self.dreams_check.get_active() else
                                      "text" if self.dream_text_check.get_active() else "summary"),
                                  points=win.appointment.open_points() if self.points_check.get_active()
                                  else None)
        except (OSError, Exception) as err:
            self.error.set_text(tr("Could not make the report: %s") % err)
            self.error.set_visible(True)
            return
        self.close()
        try:
            open_uri(GLib.filename_to_uri(path, None))
        except GLib.Error:
            pass
        win.notify(trn("Saved the report (%d page) as %s", "Saved the report (%d pages) as %s", pages) % (
            pages, os.path.basename(path)))


class BookWindow(Gtk.Window):
    """Your diary as a book: choose a period, then save it as a PDF to keep or print."""

    def __init__(self, win):
        super().__init__(title=tr("Your diary as a book"), transient_for=win, modal=True)
        self.set_default_size(460, -1)
        self.win = win
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for side in ("top", "bottom", "start", "end"):
            getattr(col, "set_margin_" + side)(20)
        intro = Gtk.Label(xalign=0, wrap=True, label=tr(
            "Your notes month by month, with the mood faces, feeling words, activities and events, "
            "as a PDF to keep or print. Moments with only a face and no words are left out."))
        intro.add_css_class("dim-label")
        col.append(intro)
        self.period = "all"
        group = None
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for key, label in BOOK_PERIODS:
            btn = Gtk.CheckButton(label=label, active=(key == "all"))
            if group:
                btn.set_group(group)
            group = group or btn
            btn.connect("toggled", lambda b, k=key: b.get_active() and self.choose(k))
            box.append(btn)
        col.append(box)
        self.private_check = Gtk.CheckButton(label=tr("Include private moments"))
        col.append(self.private_check)
        self.info = Gtk.Label(xalign=0, wrap=True)
        self.info.add_css_class("dim-label")
        col.append(self.info)
        self.private_check.connect("toggled", lambda *_: self.update())
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label=tr("Cancel"))
        cancel.connect("clicked", lambda *_: self.close())
        self.save = Gtk.Button(label=tr("Save PDF…"))
        self.save.add_css_class("suggested-action")
        self.save.connect("clicked", self.on_save)
        buttons.append(cancel)
        buttons.append(self.save)
        col.append(buttons)
        self.set_child(col)
        self.private_check.set_visible(any(is_private(e, 7) for items in win.store.days.values() for e in items))
        self.update()

    def choose(self, key):
        self.period = key
        self.update()

    def days(self):
        start, end = book_range(self.win.store, self.period)
        return book_days(self.win.store, self.win.events, start, end, self.private_check.get_active())

    def update(self):
        n = len(self.days())
        self.info.set_text(trn("%d day with words in it.", "%d days with words in them.", n) % n if n
                           else tr("Nothing written in this period yet."))
        self.save.set_sensitive(bool(n))

    def on_save(self, *_):
        start, end = book_range(self.win.store, self.period)
        self.win._pick(tr("Save your diary"), "save", lambda path: self.write(path, start, end),
                       "sottovoce-diary.pdf")

    def write(self, path, start, end):
        if not path.lower().endswith(".pdf"):
            path += ".pdf"
        win = self.win
        win.flush()
        try:
            days = export_book(path, win.store, win.events, start, end, self.private_check.get_active())
        except (OSError, Exception) as err:
            self.info.set_text(tr("Could not make the book: %s") % err)
            return
        self.close()
        try:
            open_uri(GLib.filename_to_uri(path, None))
        except GLib.Error:
            pass
        win.notify(trn("Saved your diary (%d day) as %s", "Saved your diary (%d days) as %s", days) % (
            days, os.path.basename(path)))


