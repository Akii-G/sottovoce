def hard_stretch(store, today=None):
    """Three logged days averaging 1.75 or lower within the last five, the latest of them
    today or yesterday. The same rule as Moodlog for iPhone and Android."""
    today = today or dt.date.today()
    days = [today - dt.timedelta(days=i) for i in range(5)]
    hard = [d for d in days if (store.day_avg(d) or 9) <= 1.75]
    return len(hard) >= 3 and (today in hard or today - dt.timedelta(days=1) in hard)


def show_kind_word(store, cfg, today=None):
    today = today or dt.date.today()
    if not cfg.get("kind_word", True):
        return False
    hidden = cfg.get("kind_hidden")
    try:
        if hidden and (today - dt.date.fromisoformat(hidden)).days < 7:
            return False
    except ValueError:
        pass
    return hard_stretch(store, today)


