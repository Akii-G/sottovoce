# ----------------------------------------------------------------- search

def fold(text_):
    """Text for searching: no capitals and no accents, so "perche" finds "Perché"."""
    return "".join(c for c in unicodedata.normalize("NFKD", text_.casefold())
                   if not unicodedata.combining(c))


def find_matches(text_, query):
    """[(start, end)] of every place query appears in text, ignoring capitals and accents."""
    q = fold(query.strip())
    if not q:
        return []
    folded, where = [], []          # where[i]: the original character folded[i] came from
    for i, c in enumerate(text_):
        f = fold(c)
        folded.append(f)
        where.extend([i] * len(f))
    folded = "".join(folded)
    spans, start = [], folded.find(q)
    while start >= 0:
        end = start + len(q)
        spans.append((where[start], where[end - 1] + 1))
        start = folded.find(q, end)
    return spans


def search_results(store, events, query):
    """What the search shows, newest first: ("entry", day, entry) for moods whose note or feeling
    words match, ("event", day, event) for matching events. With no query: every note."""
    q = query.strip()
    found = []
    for day in store.days:
        for entry in store.entries(day):
            note = entry[2]
            if not q:
                if note.strip():
                    found.append(("entry", day, entry))
            elif (find_matches(note, q) or find_matches(feelings_text(entry_feelings(entry)), q)
                  or find_matches(activities_text(entry_activities(entry)), q)):
                found.append(("entry", day, entry))
    if q:
        for event in events.items:
            if find_matches(event[2], q) or find_matches(event[3], q):
                found.append(("event", event[0], event))
    found.sort(key=lambda r: (r[1], r[2][0] if r[0] == "entry" else "99:99"), reverse=True)
    return found


def marked(text_, query):
    """Pango markup of text with every match in bold."""
    out, last = [], 0
    for a, b in find_matches(text_, query):
        out.append(GLib.markup_escape_text(text_[last:a]))
        out.append("<b>%s</b>" % GLib.markup_escape_text(text_[a:b]))
        last = b
    out.append(GLib.markup_escape_text(text_[last:]))
    return "".join(out)


