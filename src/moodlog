# ----------------------------------------------------------------- Windows
# On Windows there is no systemd: the daily reminder is a Task Scheduler task, the phone
# receiver starts at login from the "Run" key and is stopped by its process id, and the
# reminder is a Windows notification (toast). Everything else is the same app.
WIN_APP_ID = "Moodlog.Moodlog"          # the Start menu shortcut carries this id (installer)
WIN_TASK = "Moodlog reminder"
WIN_RUN_KEY = r"Software\Microsoft\Windows\CurrentVersion\Run"
WIN_RUN_NAME = "Moodlog phone sync"
NO_WINDOW = 0x08000000 if IS_WINDOWS else 0   # CREATE_NO_WINDOW: no console flashing up


def self_command(*args):
    """The command that runs this Moodlog again: the .exe when installed on Windows, otherwise
    the Python interpreter with this script."""
    if getattr(sys, "frozen", False):
        return [sys.executable] + list(args)
    return [sys.executable, os.path.realpath(os.path.abspath(sys.argv[0]))] + list(args)


def restart_self(args):
    """Starts Moodlog again with `args` and lets this process end. os.execv on Windows doesn't
    quote paths with spaces ("C:\\Program Files"), so there it's a new process instead."""
    if IS_WINDOWS:
        subprocess.Popen(self_command(*args), creationflags=NO_WINDOW)
        return
    cmd = self_command(*args)
    os.execv(cmd[0], cmd)


def win_run(cmd):
    try:
        done = subprocess.run(cmd, capture_output=True, text=True, timeout=20, creationflags=NO_WINDOW)
        return done.returncode == 0, (done.stderr or done.stdout).strip()
    except (OSError, subprocess.SubprocessError) as err:
        return False, str(err)


def win_apply_reminder(on, time):
    if not on:
        win_run(["schtasks", "/Delete", "/TN", WIN_TASK, "/F"])
        return True, ""
    return win_run(["schtasks", "/Create", "/TN", WIN_TASK, "/SC", "DAILY", "/ST", time, "/F",
                    "/TR", subprocess.list2cmdline(self_command("--remind"))])


def win_toast(title, body):
    """A Windows notification; clicking it opens Sottovoce (the installer registers moodlog:)."""
    def esc(text):
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace('"', "&quot;"))
    xml = ('<toast activationType="protocol" launch="moodlog:open"><visual><binding template="ToastGeneric">'
           "<text>%s</text><text>%s</text></binding></visual></toast>" % (esc(title), esc(body)))
    script = (
        "[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > $null\n"
        "[Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom.XmlDocument, ContentType = WindowsRuntime] > $null\n"
        "$x = New-Object Windows.Data.Xml.Dom.XmlDocument\n"
        "$x.LoadXml('%s')\n"
        "[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('%s').Show("
        "[Windows.UI.Notifications.ToastNotification]::new($x))\n" % (xml.replace("'", "''"), WIN_APP_ID))
    import base64
    encoded = base64.b64encode(script.encode("utf-16-le")).decode("ascii")
    return win_run(["powershell.exe", "-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden",
                    "-EncodedCommand", encoded])


def receiver_pid_path():
    return os.path.join(config_dir(), "sync-receiver.pid")


def receiver_listening(port=None):
    """True when something answers on the receiver's port on this computer."""
    port = port or sync_config()["port"]
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=0.4):
            return True
    except OSError:
        return False


def win_set_autostart(on):
    import winreg
    with winreg.CreateKey(winreg.HKEY_CURRENT_USER, WIN_RUN_KEY) as key:
        if on:
            winreg.SetValueEx(key, WIN_RUN_NAME, 0, winreg.REG_SZ,
                              subprocess.list2cmdline(self_command("--sync-server")))
        else:
            try:
                winreg.DeleteValue(key, WIN_RUN_NAME)
            except OSError:
                pass


def win_autostart_on():
    try:
        import winreg
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, WIN_RUN_KEY) as key:
            winreg.QueryValueEx(key, WIN_RUN_NAME)
            return True
    except OSError:
        return False


def win_stop_receiver():
    try:
        with open(receiver_pid_path()) as f:
            pid = int(f.read().strip())
        os.kill(pid, 15)   # TerminateProcess on Windows
    except (OSError, ValueError):
        pass
    try:
        os.remove(receiver_pid_path())
    except OSError:
        pass


def win_start_receiver():
    if not receiver_listening():
        subprocess.Popen(self_command("--sync-server"), creationflags=NO_WINDOW | 0x00000008,  # DETACHED_PROCESS
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)


def receiver_set(on):
    """Turns the phone receiver on (now and at every login) or off. Returns (ok, error)."""
    if IS_MAC:
        return (mac_agent_on(MAC_SYNC_LABEL, ["--sync-server"], {"RunAtLoad": True, "KeepAlive": True})
                if on else mac_agent_off(MAC_SYNC_LABEL))
    if not IS_WINDOWS:
        systemctl("daemon-reload")
        return systemctl("enable" if on else "disable", "--now", SERVICE)
    try:
        win_set_autostart(on)
    except OSError as err:
        return False, str(err)
    if on:
        win_start_receiver()
    else:
        win_stop_receiver()
    return True, ""


def receiver_running():
    if IS_MAC:
        return receiver_listening()
    if not IS_WINDOWS:
        return systemctl("is-active", "--quiet", SERVICE)[0]
    return receiver_listening()


def receiver_restart():
    """After the data folder changed: the receiver reads it when it starts."""
    if IS_MAC:
        mac_launchctl("kickstart", "-k", "%s/%s" % (mac_domain(), MAC_SYNC_LABEL))
    elif not IS_WINDOWS:
        systemctl("try-restart", SERVICE)
    elif receiver_running():
        win_stop_receiver()
        GLib.timeout_add(800, lambda: win_start_receiver() and False)


def resume_receiver():
    """`moodlog --resume-sync`, run by the Windows installer after an update: starts the
    receiver again if it was on."""
    if IS_WINDOWS and win_autostart_on():
        win_set_autostart(True)     # the path to Moodlog.exe may have changed
        win_start_receiver()
    return 0


def systemctl(*args):
    try:
        done = subprocess.run(["systemctl", "--user"] + list(args), capture_output=True,
                              text=True, timeout=15)
        return done.returncode == 0, (done.stderr or done.stdout).strip()
    except (OSError, subprocess.SubprocessError) as err:
        return False, str(err)


