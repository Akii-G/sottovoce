        note.add_css_class("dim-label")
        note.add_css_class("caption")
        col.append(note)
        self.set_child(col)
        self.update()

    def update(self):
        current = data_dir()
        self.path_label.set_text(current)
        self.default_btn.set_visible(os.path.abspath(current) != os.path.abspath(default_data_dir()))
        found = conflict_files()
        self.conflict_box.set_visible(bool(found))
        if found:
            self.conflict_label.set_text(
                trn("%d conflict copy found from your sync app.",
                    "%d conflict copies found from your sync app.", len(found)) % len(found))

    def on_folder(self, folder):
        win = self.win
        win.flush()
        current = os.path.abspath(data_dir())
        folder = os.path.abspath(folder)
        if folder == current:
            return
        has_data = any(os.path.exists(os.path.join(folder, n)) for n in CONTENT_FILES)
        short = folder.replace(os.path.expanduser("~"), "~", 1)
        if not has_data:
            ConfirmWindow(self, tr("Move your data to %s?") % short, (
                tr("Your moods, events and health data are copied there, and Sottovoce uses that "
                "folder from now on. The old folder keeps its copy.")),
                [(tr("Move here"), lambda: self.switch(folder, copy=True), "suggested-action")]
            ).present()
            return
        ConfirmWindow(self, tr("%s already has Sottovoce data") % short, (
            tr("Merge puts what is on this computer together with what is already there, which is "
            "what you want when setting up a second computer. Use that data switches to the "
            "folder as it is; the data here stays in the old folder.")),
            [(tr("Use that data"), lambda: self.switch(folder), None),
             (tr("Merge"), lambda: self.switch(folder, merge=True), "suggested-action")]).present()

    def switch(self, folder, copy=False, merge=False):
        import shutil
        win = self.win
        old = data_dir()
        try:
            os.makedirs(folder, exist_ok=True)
            if copy:
                for name in DATA_FILES:
                    src_path = os.path.join(old, name)
                    if os.path.exists(src_path):
                        shutil.copy2(src_path, os.path.join(folder, name))
            if merge:
                make_backup(os.path.join(folder, "backups", dt.datetime.now().strftime(
                    "before-merge-%Y%m%d-%H%M%S.zip")), folder)
                there = (Store(os.path.join(folder, "moods.csv")),
                         EventStore(os.path.join(folder, "events.csv")),
                         HealthStore(os.path.join(folder, "health.csv")),
                         DreamStore(os.path.join(folder, "dreams.csv")),
                         SurveyStore(os.path.join(folder, "surveys.json")),
                         AppointmentStore(os.path.join(folder, "appointment.json")))
                merge_folder_into(old, *there)
                for store in there:
                    store.save()
                if not os.path.exists(os.path.join(folder, "sync.json")) and \
                        os.path.exists(os.path.join(old, "sync.json")):
                    shutil.copy2(os.path.join(old, "sync.json"), os.path.join(folder, "sync.json"))
            cfg = load_config()
            if os.path.abspath(folder) == os.path.abspath(default_data_dir()):
                cfg.pop("data_dir", None)
            else:
                cfg["data_dir"] = folder
            save_config(cfg)
        except OSError as err:
            win.notify(tr("Could not use that folder: %s") % (err.strerror or err))
            return
        receiver_restart()  # the phone receiver reads the folder when it starts
        win.reload_data()
        self.update()
        win.notify(tr("Sottovoce now uses %s") % folder)


