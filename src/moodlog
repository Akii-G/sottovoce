def version_key(version):
    try:
        return tuple(int(part) for part in str(version).split("."))
    except ValueError:
        return (0,)


def changelog_markdown():
    lines = ["# Changelog", "",
             "Sottovoce for the PC, Sottovoce for iPhone and Sottovoce for Android have their own "
             "version numbers. Each GitHub release is named after the PC version and includes "
             "all three apps.", ""]
    for heading, log in (("Sottovoce for the PC", CHANGELOG),
                         ("Sottovoce for iPhone", IPHONE_CHANGELOG),
                         ("Sottovoce for Android", ANDROID_CHANGELOG)):
        lines.append("## " + heading)
        lines.append("")
        for version, day, items in log:
            lines.append("### %s (%s)" % (version, day))
            lines.append("")
            lines.extend("- " + item for item in items)
            lines.append("")
    return "\n".join(lines)


