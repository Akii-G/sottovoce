def survey_score(survey):
    return sum(survey["answers"])


def clean_survey(item):
    """One questionnaire from JSON (a file or the phone), checked field by field, or None.
    {id, date, time, kind, answers: [0-3 per question], difficulty: -1 (not asked) or 0-3, updated,
    private: true if it must stay out of the doctor report}"""
    if not isinstance(item, dict):
        return None
    try:
        day = dt.date.fromisoformat(str(item.get("date")))
    except ValueError:
        return None
    kind = item.get("kind")
    sid, stamp = str(item.get("id") or "")[:64], clean_stamp(str(item.get("updated") or ""))
    answers = item.get("answers")
    if kind not in SURVEY_KINDS or not sid or not stamp or not isinstance(answers, list):
        return None
    if len(answers) != survey_size(kind) or not all(
            isinstance(a, int) and not isinstance(a, bool) and 0 <= a <= 3 for a in answers):
        return None
    diff = item.get("difficulty")
    diff = diff if isinstance(diff, int) and not isinstance(diff, bool) and 0 <= diff <= 3 else -1
    time = str(item.get("time") or "")
    if not TIME_RE.match(time):
        time = ""
    return {"id": sid, "date": day, "time": time, "kind": kind, "answers": list(answers),
            "difficulty": diff, "updated": stamp, "private": item.get("private") is True}


def survey_json(s):
    out = {"id": s["id"], "date": s["date"].isoformat(), "time": s["time"], "kind": s["kind"],
           "answers": list(s["answers"]), "difficulty": s["difficulty"], "updated": s["updated"]}
    if s.get("private"):
        out["private"] = True
    return out


class SurveyStore:
    """Answered questionnaires: surveys.json. Merged like moods: the newest change wins and
    deletions are kept, so a questionnaire deleted on one device goes away on the others."""

    def __init__(self, path=None):
        self.path = os.path.join(data_dir(), "surveys.json") if path is None else path
        self.items = []
        self.deleted = {}
        self.mtime = None
        if self.path:
            self.load()

    def load(self):
        self.items, self.deleted = [], {}
        self.mtime = file_mtime(self.path)
        try:
            with open(self.path, encoding="utf-8") as f:
                doc = json.load(f)
        except (OSError, ValueError):
            return
        self.absorb_json(doc if isinstance(doc, dict) else {})

    def absorb_json(self, doc):
        """Read {"surveys": [...], "deleted": [{type: "survey"}...]} into this store."""
        other = SurveyStore("")
        for item in (doc.get("surveys") or [])[:20000]:
            s = clean_survey(item)
            if s:
                other.items.append(s)
        for item in (doc.get("deleted") or [])[:200000]:
            if isinstance(item, dict) and item.get("type") == "survey":
                sid, gone = str(item.get("id") or "")[:64], clean_stamp(str(item.get("deleted") or ""))
                if sid and gone:
                    other.deleted[sid] = max(gone, other.deleted.get(sid, ""))
        return self.absorb(other)

    def changed_on_disk(self):
        return bool(self.path) and file_mtime(self.path) != self.mtime

    def to_json(self):
        return {"surveys": [survey_json(s) for s in self.items],
                "deleted": [{"id": sid, "type": "survey", "deleted": gone}
                            for sid, gone in sorted(self.deleted.items())]}

    def save(self):
        if not self.path:
            return
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.to_json(), f, ensure_ascii=False, indent=1)
        os.replace(tmp, self.path)
        self.mtime = file_mtime(self.path)

    def sort(self):
        self.items.sort(key=lambda s: (s["date"], s["time"], s["kind"]))

    def add(self, kind, answers, difficulty=-1, day=None, time=None, private=False):
        now = dt.datetime.now()
        s = {"id": new_id(), "date": day or now.date(), "time": time if time is not None else now.strftime("%H:%M"),
             "kind": kind, "answers": list(answers), "difficulty": difficulty, "updated": now_stamp(),
             "private": bool(private)}
        self.items.append(s)
        self.sort()
        return s

    def remove(self, survey, stamp=None):
        self.items = [s for s in self.items if s["id"] != survey["id"]]
        self.deleted[survey["id"]] = stamp or now_stamp()

    def absorb(self, other):
        changed = 0
        mine = {s["id"]: s for s in self.items}
        for sid, gone in other.deleted.items():
            s = mine.get(sid)
            if s is not None and s["updated"] <= gone:
                self.remove(s, stamp=gone)
                mine.pop(sid)
                changed += 1
            elif s is None and self.deleted.get(sid, "") < gone:
                self.deleted[sid] = gone
        for theirs in other.items:
            sid = theirs["id"]
            if sid in self.deleted and self.deleted[sid] >= theirs["updated"]:
                continue
            s = mine.get(sid)
            if s is None:
                copy = dict(theirs, answers=list(theirs["answers"]))
                self.items.append(copy)
                mine[sid] = copy
                self.deleted.pop(sid, None)
                changed += 1
            elif theirs["updated"] > s["updated"]:
                s.clear()
                s.update(theirs, answers=list(theirs["answers"]))
                changed += 1
        self.sort()
        return changed

    def between(self, start=None, end=None, kind=None):
        return [s for s in self.items if (not start or s["date"] >= start)
                and (not end or s["date"] <= end) and (not kind or s["kind"] == kind)]

    def latest(self, kind=None):
        found = self.between(kind=kind)
        return found[-1] if found else None

    def due(self, today=None):
        """True when the last questionnaire is 14 or more days old (or there is none yet)."""
        today = today or dt.date.today()
        last = self.latest()
        return last is None or (today - last["date"]).days >= SURVEY_EVERY_DAYS


class AppointmentStore:
    """The next doctor or therapist appointment and the things to talk about there:
    appointment.json. Synced like the rest: the appointment as a whole and each point on its
    own, newest change wins; deleted points are kept as tombstones (type "point").

    appt: {"date": date or None, "time": "HH:MM" or "", "with": "", "previous": date or None,
    "updated": stamp}. "previous" is the appointment before, so the recap knows where to start.
    Each point: {"id", "text", "done", "updated"}; done = already said, kept out of reports."""

    def __init__(self, path=None):
        self.path = os.path.join(data_dir(), "appointment.json") if path is None else path
        self.appt = empty_appointment()
        self.points = []
        self.deleted = {}
        self.mtime = None
        if self.path:
            self.load()

    def load(self):
        self.appt, self.points, self.deleted = empty_appointment(), [], {}
        self.mtime = file_mtime(self.path)
        try:
            with open(self.path, encoding="utf-8") as f:
                doc = json.load(f)
        except (OSError, ValueError):
            return
        self.absorb_json(doc if isinstance(doc, dict) else {})

    def changed_on_disk(self):
        return bool(self.path) and file_mtime(self.path) != self.mtime

    def absorb_json(self, doc):
        """Read {"appointment": {...}, "points": [...], "deleted": [{type: "point"}...]}."""
        other = AppointmentStore("")
        appt = clean_appointment(doc.get("appointment"))
        if appt:
            other.appt = appt
        for item in (doc.get("points") or [])[:5000]:
            point = clean_point(item)
            if point:
                other.points.append(point)
        for item in (doc.get("deleted") or [])[:200000]:
            if isinstance(item, dict) and item.get("type") == "point":
                pid, gone = str(item.get("id") or "")[:64], clean_stamp(str(item.get("deleted") or ""))
                if pid and gone:
                    other.deleted[pid] = max(gone, other.deleted.get(pid, ""))
        return self.absorb(other)

    def to_json(self):
        a = self.appt
        doc = {"points": [dict(p) for p in self.points],
               "deleted": [{"id": pid, "type": "point", "deleted": gone}
                           for pid, gone in sorted(self.deleted.items())]}
        if a["updated"]:
            doc["appointment"] = {"date": a["date"].isoformat() if a["date"] else "", "time": a["time"],
                                  "with": a["with"],
                                  "previous": a["previous"].isoformat() if a["previous"] else "",
                                  "updated": a["updated"]}
        return doc

    def save(self):
        if not self.path:
            return
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.to_json(), f, ensure_ascii=False, indent=1)
        os.replace(tmp, self.path)
        self.mtime = file_mtime(self.path)

    def absorb(self, other):
        changed = 0
        if other.appt["updated"] > self.appt["updated"]:
            self.appt = dict(other.appt)
            changed += 1
        mine = {p["id"]: p for p in self.points}
        for pid, gone in other.deleted.items():
            p = mine.get(pid)
            if p is not None and p["updated"] <= gone:
                self.remove_point(p, stamp=gone)
                mine.pop(pid)
                changed += 1
            elif p is None and self.deleted.get(pid, "") < gone:
                self.deleted[pid] = gone
        for theirs in other.points:
            pid = theirs["id"]
            if pid in self.deleted and self.deleted[pid] >= theirs["updated"]:
                continue
            p = mine.get(pid)
            if p is None:
                copy = dict(theirs)
                self.points.append(copy)
                mine[pid] = copy
                self.deleted.pop(pid, None)
                changed += 1
            elif theirs["updated"] > p["updated"]:
                p.update(theirs)
                changed += 1
        return changed

    def set_appointment(self, day, time="", with_="", today=None):
        """Set (or with day None, clear) the next appointment. When the old one has already
        happened, it becomes "previous", where the recap starts from."""
        today = today or dt.date.today()
        old = self.appt
        previous = old["previous"]
        if old["date"] and old["date"] <= today and old["date"] != day:
            previous = old["date"]
        self.appt = {"date": day, "time": time if day else "", "with": with_ if day else "",
                     "previous": previous, "updated": now_stamp()}

    def add_point(self, text_):
        point = {"id": new_id(), "text": " ".join(text_.split())[:500], "done": False, "updated": now_stamp()}
        self.points.append(point)
        return point

    def set_done(self, point, done):
        point["done"] = bool(done)
        point["updated"] = now_stamp()

    def remove_point(self, point, stamp=None):
        self.points = [p for p in self.points if p["id"] != point["id"]]
        self.deleted[point["id"]] = stamp or now_stamp()

    def open_points(self):
        return [p for p in self.points if not p["done"]]

    def card_shown(self, today=None):
        """The appointment card on the Log page: from a week before until the day after."""
        today = today or dt.date.today()
        day = self.appt["date"]
        return bool(day) and -1 <= (day - today).days <= 7

    def recap_start(self, today=None):
        """Where "since the last appointment" starts: the previous one, or 30 days ago."""
        today = today or dt.date.today()
        prev = self.appt["previous"]
        return prev if prev and prev < today else today - dt.timedelta(days=29)


def empty_appointment():
    return {"date": None, "time": "", "with": "", "previous": None, "updated": ""}


def clean_appointment(item):
    if not isinstance(item, dict):
        return None
    stamp = clean_stamp(str(item.get("updated") or ""))
    if not stamp:
        return None

    def day(value):
        try:
            return dt.date.fromisoformat(str(value or ""))
        except ValueError:
            return None
    time = str(item.get("time") or "")
    return {"date": day(item.get("date")), "time": time if TIME_RE.match(time) else "",
            "with": " ".join(str(item.get("with") or "").split())[:200],
            "previous": day(item.get("previous")), "updated": stamp}


def clean_point(item):
    if not isinstance(item, dict):
        return None
    pid, stamp = str(item.get("id") or "")[:64], clean_stamp(str(item.get("updated") or ""))
    text_ = " ".join(str(item.get("text") or "").split())[:500]
    if not pid or not stamp or not text_:
        return None
    return {"id": pid, "text": text_, "done": item.get("done") is True, "updated": stamp}


def appointment_when(appt, today=None):
    """"Thursday 3 December at 16:30 · in 3 days" (with whom, when known)."""
    today = today or dt.date.today()
    day = appt["date"]
    text_ = fmt_date(day, tr("%A %-d %B"))
    if appt["time"]:
        text_ = tr("%s at %s") % (text_, appt["time"])
    if appt["with"]:
        text_ = tr("%s, with %s") % (text_, appt["with"])
    days = (day - today).days
    rel = (tr("today") if days == 0 else tr("tomorrow") if days == 1 else tr("yesterday") if days == -1
           else trn("in %d day", "in %d days", days) % days if days > 0
           else trn("%d day ago", "%d days ago", -days) % -days)
    return "%s · %s" % (text_, rel)


def appointment_recap(store, events, start, end):
    """One calm line about the time since the last appointment: days logged, the usual mood,
    the most frequent feeling words and how many events."""
    days = [start + dt.timedelta(days=i) for i in range((end - start).days + 1)]
    logged = [d for d in days if store.day_avg(d)]
    if not logged:
        return tr("Since %s: no moods logged yet.") % fmt_date(start, "%-d %B")
    moods = [m for _d, _t, m in store.timed(start, end) if m]
    parts = [trn("%d day logged", "%d days logged", len(logged)) % len(logged)]
    if moods:
        common = max(range(1, 6), key=lambda m: (moods.count(m), m))
        parts.append(tr("mostly %s") % MOOD_NAMES[common].lower())
    counts = feeling_counts(store, start, end)
    top = [FEELING_LABELS[k] for k, n in counts[:2] if n > 1]
    if top:
        parts.append(tr("often %s") % ", ".join(top))
    n_events = len(events.between(start, end))
    if n_events:
        parts.append(trn("%d event", "%d events", n_events) % n_events)
    return tr("Since %s: %s.") % (fmt_date(start, "%-d %B"), " · ".join(parts))


def week_look_back(store, now=None):
    """"Your week, gently": from Sunday 18:00 until the end of Monday, a few plain sentences about
    the week (Monday to Sunday) that is ending or just ended. None when there is nothing to say.
    Returns (monday, text)."""
    now = now or dt.datetime.now()
    today = now.date()
    if today.weekday() == 6 and now.hour >= 18:
        monday = today - dt.timedelta(days=6)
    elif today.weekday() == 0:
        monday = today - dt.timedelta(days=7)
    else:
        return None
    sunday = monday + dt.timedelta(days=6)
    days = [monday + dt.timedelta(days=i) for i in range(7)]
    logged = [d for d in days if store.day_avg(d)]
    if not logged:
        return None
    moods = [m for _d, _t, m in store.timed(monday, sunday) if m]
    common = max(range(1, 6), key=lambda m: (moods.count(m), m))
    lines = [trn("%d day logged, mostly %s.", "%d days logged, mostly %s.", len(logged)) % (
        len(logged), MOOD_NAMES[common].lower())]
    counts = feeling_counts(store, monday, sunday)
    if counts:
        key, n = counts[0]
        if n > 1:
            lines.append(trn("%s came up %d time.", "%s came up %d times.", n) % (FEELING_LABELS[key], n))
    if len(logged) >= 2:
        avgs = {d: store.day_avg(d) for d in logged}
        best = max(logged, key=lambda d: (avgs[d], d))
        if avgs[best] > min(avgs.values()):
            lines.append(tr("%s was your best day.") % fmt_date(best, "%A").capitalize())
    return monday, " ".join(lines)


