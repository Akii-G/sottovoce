_style_provider = {"css": None}


def apply_style(name):
    """Switch the look of every Sottovoce window. 'default' removes the extra CSS."""
    STYLE["name"] = name if name in dict(STYLES) else "default"
    display = Gdk.Display.get_default()
    if display is None:
        return
    if _style_provider["css"] is not None:
        Gtk.StyleContext.remove_provider_for_display(display, _style_provider["css"])
        _style_provider["css"] = None
    if _style_provider.get("base") is None:
        # Tabs only as wide as their label (libadwaita makes each one 100px or more), so
        # all five tabs and the buttons fit when the window has half a screen.
        base = Gtk.CssProvider()
        css = ("headerbar stackswitcher > button { min-width: 0; padding-left: 14px; padding-right: 14px; }\n"
               ".tour-card { background-color: @window_bg_color; color: @window_fg_color; "
               "border-radius: 18px; padding: 20px; box-shadow: 0 12px 40px rgba(0,0,0,0.35); }\n"
               "button.feeling:checked { background-color: @accent_bg_color; color: @accent_fg_color; "
               "font-weight: 700; }\n"
               ".kind-word { background-color: alpha(@accent_bg_color, 0.10); border-radius: 12px; "
               "padding: 14px; }\n"
               ".dose-taken { color: @success_color; font-weight: 600; }\n"
               ".dose-skipped { opacity: 0.65; font-weight: 600; }\n"
               ".dose-pending { color: @warning_color; font-weight: 600; }")
        try:
            base.load_from_string(css)
        except AttributeError:
            base.load_from_data(css.encode("utf-8"), -1)
        Gtk.StyleContext.add_provider_for_display(display, base, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        _style_provider["base"] = base
    if STYLE["name"] == "tahoe":
        provider = Gtk.CssProvider()
        css = _TAHOE_DARK if is_dark() else _TAHOE_LIGHT
        try:
            provider.load_from_string(css)  # GTK 4.12 and newer
        except AttributeError:
            provider.load_from_data(css.encode("utf-8"), -1)
        # Above the user's own ~/.config/gtk-4.0/gtk.css (where many system themes put
        # their rules), so a chosen style really applies. Only while Tahoe is selected.
        Gtk.StyleContext.add_provider_for_display(display, provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        _style_provider["css"] = provider


