class MedicineNamesWindow(Gtk.Window):
    """Show a medicine logged under several names (Apple Health, then Dose) as one."""

    def __init__(self, win, on_change=None):
        super().__init__(title=tr("Medicine names"), transient_for=win, modal=True)
        self.set_default_size(520, 600)
        self.win, self.on_change = win, on_change
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for side in ("top", "bottom", "start", "end"):
            getattr(col, "set_margin_" + side)(20)
        intro = Gtk.Label(xalign=0, wrap=True, label=tr(
            "If you logged one medicine under different names (for example in Apple Health and "
            "then in Dose), give them one name: all its doses then show under it, here and on your "
            "phones. Don't do it for two strengths if your dose really changed."))
        intro.add_css_class("dim-label")
        col.append(intro)
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(self.box)
        col.append(scroll)
        done = Gtk.Button(label=tr("Done"), halign=Gtk.Align.END)
        done.add_css_class("suggested-action")
        done.connect("clicked", lambda *_: self.close())
        col.append(done)
        self.set_child(col)
        self.fill()

    def heading(self, text):
        label = Gtk.Label(label=text, xalign=0, margin_top=6)
        label.add_css_class("heading")
        self.box.append(label)

    def describe(self, name, info):
        first, last, from_dose = info
        where = tr("Dose") if from_dose else tr("Apple Health")
        span = fmt_date(first, "%-d %b") if first == last else "%s – %s" % (
            fmt_date(first, "%-d %b"), fmt_date(last, "%-d %b %Y"))
        return "%s · %s" % (where, span)

    def fill(self):
        while (child := self.box.get_first_child()) is not None:
            self.box.remove(child)
        meds = self.win.meds
        logged = meds.logged_names()
        groups = meds.suggestions()
        if groups:
            self.heading(tr("These look like the same medicine"))
            for group in groups:
                self.box.append(self.group_row(group, logged, suggested=True))
        combined = {}
        for name, shown in meds.same.items():
            combined.setdefault(shown, []).append(name)
        if combined:
            self.heading(tr("Renamed"))
            for shown in sorted(combined, key=str.lower):
                self.box.append(self.combined_row(shown, sorted(combined[shown], key=str.lower), logged))
        self.heading(tr("Other names"))
        hint = Gtk.Label(xalign=0, wrap=True, label=tr("Tick two or more names, then give them one name."))
        hint.add_css_class("dim-label")
        hint.add_css_class("caption")
        self.box.append(hint)
        free = sorted((n for n in logged if n not in meds.same), key=str.lower)
        self.box.append(self.group_row(free, logged, suggested=False))

    def group_row(self, names, logged, suggested):
        frame = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        frame.add_css_class("boxed-list")
        checks = []
        for name in names:
            row = Adw.ActionRow(title=GLib.markup_escape_text(name),
                                subtitle=self.describe(name, logged.get(name, (dt.date.today(),) * 2 + (False,))))
            check = Gtk.CheckButton(active=suggested, valign=Gtk.Align.CENTER)
            row.add_prefix(check)
            row.set_activatable_widget(check)
            checks.append((name, check))
            frame.append(row)
        newest = max(names, key=lambda n: logged.get(n, (dt.date.min,) * 2)[1]) if names else ""
        entry = Gtk.Entry(hexpand=True, text=newest if suggested else "",
                          placeholder_text=tr("Name to show in the report"))
        button = Gtk.Button(label=tr("Use this name"))
        button.add_css_class("suggested-action")

        def combine(*_):
            chosen = [n for n, c in checks if c.get_active()]
            shown = entry.get_text().strip() or (max(chosen, key=lambda n: logged.get(n, (dt.date.min,) * 2)[1])
                                                 if chosen else "")
            if len(chosen) < 2 or not shown:
                self.win.notify(tr("Tick at least two names."))
                return
            self.save(lambda: self.win.meds.combine(chosen, shown))
        button.connect("clicked", combine)
        entry.connect("activate", combine)
        line = Gtk.Box(spacing=8, margin_top=6, margin_bottom=6, margin_start=12, margin_end=12)
        line.append(entry)
        line.append(button)
        frame.append(line)
        return frame

    def combined_row(self, shown, names, logged):
        frame = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        frame.add_css_class("boxed-list")
        head = Adw.ActionRow(title=GLib.markup_escape_text(shown),
                             subtitle=GLib.markup_escape_text(", ".join(names)))
        split = Gtk.Button(label=tr("Undo"), valign=Gtk.Align.CENTER)
        split.connect("clicked", lambda *_: self.save(lambda: self.win.meds.separate(shown)))
        head.add_suffix(split)
        frame.append(head)
        return frame

    def save(self, change):
        try:
            change()
        except OSError as err:
            self.win.notify(tr("Could not save: %s") % err)
            return
        if self.on_change:
            self.on_change()
        self.win.refresh()
        self.fill()


