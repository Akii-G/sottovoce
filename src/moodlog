def clean_feelings(value):
    """Feeling words as one text in a fixed order ("joy,tiredness"); unknown words are dropped."""
    if isinstance(value, str):
        value = value.replace(";", ",").split(",")
    wanted = {str(v).strip().lower() for v in value or []} if isinstance(value, (list, tuple, set, str)) else set()
    return ",".join(key for key, _label in FEELINGS if key in wanted)


def entry_feelings(entry):
    """The feeling keys of an entry ([] for entries without any)."""
    return [k for k in (entry[8] if len(entry) > 8 and entry[8] else "").split(",") if k]


def feeling_counts(store, start=None, end=None):
    """[(key, how many entries)] in the period, most often first; private entries left out."""
    counts = {}
    for day in store.days:
        if (start and day < start) or (end and day > end):
            continue
        for e in store.days[day]:
            if not is_private(e, 7):
                for k in entry_feelings(e):
                    counts[k] = counts.get(k, 0) + 1
    order = [k for k, _l in FEELINGS]
    return sorted(counts.items(), key=lambda kv: (-kv[1], order.index(kv[0])))


def feelings_text(keys):
    return ", ".join(FEELING_LABELS[k] for k in keys if k in FEELING_LABELS)


def activity_counts(store, start=None, end=None):
    """[(key, how many entries)] in the period, most often first; private entries left out."""
    counts = {}
    for day in store.days:
        if (start and day < start) or (end and day > end):
            continue
        for e in store.days[day]:
            if not is_private(e, 7):
                for k in entry_activities(e):
                    counts[k] = counts.get(k, 0) + 1
    order = [k for k, _l in ACTIVITIES]
    return sorted(counts.items(), key=lambda kv: (-kv[1], order.index(kv[0])))


