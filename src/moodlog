EVENT_KINDS = [("medication", tr("Medication change")), ("health", tr("Health")),
               ("life", tr("Life event")), ("other", tr("Other"))]
EVENT_LABELS = dict(EVENT_KINDS)
AROUND_DAYS = 14


class EventStore:
    """Important events (a medication change, a move...): events.csv.

    Each event is [date, kind, title, note, id, updated]; deletions are kept like for moods.
    """

    def __init__(self, path=None):
        self.path = path or os.path.join(data_dir(), "events.csv")
        self.mtime = None
        self.items = []
        self.deleted = {}
        if path != "":
            self.load()

    def load(self):
        self.items = []
        self.deleted = {}
        self.mtime = file_mtime(self.path)
        if not os.path.exists(self.path):
            return
        with open(self.path, newline="", encoding="utf-8-sig") as f:
            for row in csv.DictReader(f):
                eid = (row.get("id") or "").strip()
                gone = clean_stamp(row.get("deleted"))
                if gone and eid:
                    self.deleted[eid] = gone
                    continue
                try:
                    day = dt.date.fromisoformat((row.get("date") or "").strip())
                except ValueError:
                    continue
                title = (row.get("title") or "").strip()
                if not title:
                    continue
                kind = (row.get("kind") or "").strip()
                if kind not in EVENT_LABELS:
                    kind = "other"
                note = row.get("note") or ""
                if not eid:
                    eid = legacy_id("event", day, kind, title, note)
                self.items.append([day, kind, title, note, eid, clean_stamp(row.get("updated"))])
        self.sort()

    def save(self):
        if self.changed_on_disk():
            self.absorb(type(self)(self.path))
        tmp = self.path + ".tmp"
        with open(tmp, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(["date", "kind", "title", "note", "id", "updated", "deleted"])
            for day, kind, title, note, eid, updated in self.items:
                w.writerow([day.isoformat(), kind, title, note, eid, updated, ""])
            for eid, gone in sorted(self.deleted.items()):
                w.writerow(["", "", "", "", eid, "", gone])
        os.replace(tmp, self.path)
        self.mtime = file_mtime(self.path)

    def changed_on_disk(self):
        return file_mtime(self.path) != self.mtime

    def sort(self):
        self.items.sort(key=lambda e: e[0])

    def add(self, day, kind, title, note, eid=None, updated=None):
        event = [day, kind, title, note, eid or new_id(), updated or now_stamp()]
        self.items.append(event)
        self.sort()
        return event

    def update(self, event, day, kind, title, note):
        event[:4] = [day, kind, title, note]
        event[5] = now_stamp()
        self.sort()

    def remove(self, event, stamp=None):
        if len(event) > 4:
            self.deleted[event[4]] = stamp or now_stamp()
        self.items = [e for e in self.items if e is not event]

    def absorb(self, other):
        changed = 0
        mine = {e[4]: e for e in self.items}
        for eid, gone in other.deleted.items():
            event = mine.get(eid)
            if event is not None and event[5] <= gone:
                self.remove(event, stamp=gone)
                mine.pop(eid)
                changed += 1
            elif event is None and self.deleted.get(eid, "") < gone:
                self.deleted[eid] = gone
        for theirs in other.items:
            eid = theirs[4]
            if self.deleted.get(eid, "") >= theirs[5] and eid in self.deleted:
                continue
            event = mine.get(eid)
            if event is None and any(e[:4] == theirs[:4] for e in self.items):
                continue  # the same event, created separately on two devices
            if event is None:
                copy = list(theirs)
                self.items.append(copy)
                mine[eid] = copy
                self.deleted.pop(eid, None)
                changed += 1
            elif theirs[5] > event[5]:
                event[:] = list(theirs)
                changed += 1
        self.sort()
        return changed

    def on(self, day):
        return [e for e in self.items if e[0] == day]

    def between(self, start=None, end=None):
        return [e for e in self.items
                if (not start or e[0] >= start) and (not end or e[0] <= end)]


def event_line(event):
    return "%s — %s: %s" % (fmt_date(event[0], "%a %-d %b"), EVENT_LABELS[event[1]], event[2])


def mood_around(store, day, span=AROUND_DAYS):
    """Average mood in the `span` days before an event and from the event day on."""
    def window(a, b):
        vals = [store.day_avg(d) for d in store.days if a <= d <= b]
        vals = [v for v in vals if v]
        return (sum(vals) / len(vals), len(vals)) if vals else (0.0, 0)
    before = window(day - dt.timedelta(days=span), day - dt.timedelta(days=1))
    after = window(day, day + dt.timedelta(days=span - 1))
    complete = day + dt.timedelta(days=span - 1) <= dt.date.today()
    return before, after, complete


def event_summary(store, event):
    day = event[0]
    if day > dt.date.today():
        return tr("Planned. Your mood before and after will be compared once it has happened.")
    (b_avg, b_n), (a_avg, a_n), complete = mood_around(store, day)
    weeks = tr("%d weeks") % (AROUND_DAYS // 7)

    def part(avg, n):
        if n < 3:
            return tr("not enough days logged (%d)") % n
        return trn("%.1f (%d day logged)", "%.1f (%d days logged)", n) % (avg, n)

    text_ = tr("Mood in the %s before: %s · after: %s") % (weeks, part(b_avg, b_n), part(a_avg, a_n))
    if not complete:
        text_ += tr(", so far")
    return text_


