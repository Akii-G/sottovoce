LANGUAGES = [("auto", "Automatic"), ("en", "English"), ("it", "Italiano")]


def system_language():
    for var in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        value = (os.environ.get(var) or "").split(":")[0]
        if value:
            code = value.split(".")[0].split("_")[0].split("@")[0].lower()
            return "en" if code in ("c", "posix") else code
    if IS_MAC:   # an app opened from the Dock has no LANG: ask macOS for the preferred language
        try:
            out = subprocess.run(["defaults", "read", "-g", "AppleLanguages"], capture_output=True,
                                 text=True, timeout=3).stdout
            first = re.search(r'"?([A-Za-z]{2,3})[-_A-Za-z]*"?', out.split("(", 1)[-1])
            if first:
                return first.group(1).lower()
        except (OSError, subprocess.SubprocessError):
            pass
    if IS_WINDOWS:   # Windows has no LANG: GLib reads the Windows display language
        for name in GLib.get_language_names():
            code = name.split(".")[0].split("_")[0].split("@")[0].lower()
            if code not in ("c", "posix", ""):
                return code
    return "en"


