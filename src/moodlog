        if self._loading:
            return
        self.commit()
        self.calendar.queue_draw()

    def on_private_toggled(self, _check):
        if self._loading or self.current is None:
            return      # a new entry: the tick is read when it's created
        while len(self.current) < 8:
            self.current.append(False)
        self.current[7] = self.private_check.get_active()
        self.store.touch(self.current)
        self.schedule_save()
        self.rebuild_entries()

    def on_entry_row(self, _list, row):
        self.apply_time()
        self.current = row.entry
        self.load_editor()
        GLib.idle_add(self.rebuild_entries)

    def on_new(self, _btn):
        self.apply_time()
        self.current = None
        self.load_editor()
        self.rebuild_entries()

    def on_delete(self, _btn):
        if self.current is None:
            return
        self.store.remove(self.selected, self.current)
        self.current = None
        self.load_editor()
        self.rebuild_entries()
        self.schedule_save()
        self.refresh()

    def commit(self):
        """Write the editor into the store: creates the entry on first input."""
        mood, note, day = self.current_mood(), self.current_note(), self.selected
        energy, anxiety = self.current_scale(3), self.current_scale(4)
        feelings, acts = self.current_feelings(), self.current_activities()
        empty = not mood and not note.strip() and not energy and not anxiety and not feelings and not acts
        if self.current is None:
            if empty:
                return
            value = self.read_time() or ""
            if day == dt.date.today() and not self._time_touched:
                value = dt.datetime.now().strftime("%H:%M")
            private = self.prefs["private_tick"] and self.private_check.get_active()
            self.current = self.store.add(day, value, mood, note, energy, anxiety, private=private,
                                          feelings=feelings, activities=acts)
            self._loading = True
            self.time_entry.set_text(self.current[0])
            self.time_entry.remove_css_class("error")
            self._loading = False
            self.update_mode()
        else:
            self.current[1:5] = [mood, note, energy, anxiety]
            while len(self.current) < 10:
                self.current.append(False if len(self.current) == 7 else "")
            self.current[8] = feelings
            self.current[9] = acts
            self.store.touch(self.current)
            if empty:
                self.store.remove(day, self.current)
                self.current = None
                self.update_mode()
        self.schedule_save()

    def rebuild_entries(self):
        """List of the selected day's entries, above the editor."""
        child = self.entry_list.get_first_child()
        while child:
            self.entry_list.remove(child)
            child = self.entry_list.get_first_child()
        items = self.store.entries(self.selected)
        for entry in items:
            time, mood, note, energy, anxiety = entry[:5]
            row = Gtk.ListBoxRow()
            row.entry = entry
            row.set_tooltip_text(tr("Click to edit this entry"))
            box = Gtk.Box(spacing=10)
            for side in ("top", "bottom"):
                getattr(box, "set_margin_" + side)(6)
            for side in ("start", "end"):
                getattr(box, "set_margin_" + side)(10)
            when = Gtk.Label(label=time or "––:––", xalign=0)
            when.set_width_chars(5)
            when.add_css_class("heading" if entry is self.current else "dim-label")
            box.append(when)
            if mood:
                box.append(FaceIcon(mood, 26, badge=True))
                name = Gtk.Label(label=MOOD_NAMES[mood], xalign=0)
                box.append(name)
            if energy or anxiety:
                extra = Gtk.Label(label=" ".join(
                    "%s%d" % (letter, value) for letter, value in (("E", energy), ("A", anxiety))
                    if value), xalign=0)
                extra.set_tooltip_text(", ".join("%s %d" % (word, value) for word, value in
                                                 (("energy", energy), ("anxiety", anxiety)) if value))
                extra.add_css_class("caption")
                box.append(extra)
            words = feelings_text(entry_feelings(entry)) if self.prefs["feelings"] else ""
            did = activities_text(entry_activities(entry)) if self.prefs["activities"] else ""
            snippet = Gtk.Label(label=" · ".join(p for p in (words, did, " ".join(note.split())) if p),
                                xalign=0, hexpand=True)
            snippet.set_ellipsize(Pango.EllipsizeMode.END)
            snippet.add_css_class("dim-label")
            box.append(snippet)
            if is_private(entry, 7) and self.prefs["private_tick"]:
                lock = Gtk.Image.new_from_icon_name("changes-prevent-symbolic")
                lock.set_tooltip_text(tr("Private: never in the doctor report"))
                lock.add_css_class("dim-label")
                box.append(lock)
            row.set_child(box)
            self.entry_list.append(row)
        self.entry_scroll.set_visible(bool(items))
        return False

    def schedule_save(self):
        if self._save_id:
            GLib.source_remove(self._save_id)
        self._save_id = GLib.timeout_add(500, self.flush)

    def flush(self):
        self.apply_time()
        if self._save_id:
            GLib.source_remove(self._save_id)
            self._save_id = 0
            try:
                self.store.save()
                self.saved_label.set_text(tr("Saved"))
            except OSError as err:
                self.saved_label.set_text(tr("Could not save: %s") % err)
            self.sync_widget()
            self.rebuild_entries()
        return False

    def on_close(self, *_):
        self.flush()
        return False

