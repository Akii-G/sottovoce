            events.add(day, kind, title, note)
        if self.win.save_events():
            self.close()
        else:
            self.fail(tr("Could not save the event to events.csv."))

    def on_delete(self, *_):
        self.win.events.remove(self.event)
        if self.win.save_events():
            self.close()
        else:
            self.fail(tr("Could not save the change to events.csv."))


