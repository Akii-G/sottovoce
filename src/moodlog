                                                            self.on_folder))
        self.default_btn = Gtk.Button(label=tr("Go back to the default folder"))
        self.default_btn.connect("clicked", lambda *_: self.on_folder(default_data_dir()))
        buttons.append(choose)
        buttons.append(self.default_btn)
        col.append(buttons)

        self.conflict_box = Gtk.Box(spacing=10)
        self.conflict_label = Gtk.Label(xalign=0, wrap=True, hexpand=True)
        merge = Gtk.Button(label=tr("Merge them"))
        merge.connect("clicked", lambda *_: (win.merge_conflict_copies(), self.update()))
