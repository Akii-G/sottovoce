    def survey_due(self, today=None):
        """The two-week card: questionnaires on, reminder on, one answered 14+ days ago, and not
        put off with "Not now" in the last three days."""
        today = today or dt.date.today()
        if not (self.prefs["questionnaires"] and self.prefs["survey_remind"]) or not self.surveys.items:
            return False
        if not self.surveys.due(today):
            return False
        later = load_config().get("survey_later")
        try:
            if later and (today - dt.date.fromisoformat(later)).days < 3:
                return False
        except ValueError:
            pass
        return True

