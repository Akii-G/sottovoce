def medication_button(doses, today=None):
    """'Medication · 4 taken · 1 skipped': opens the list of every dose that day."""
    counts = {k: sum(1 for d in doses if d[2] == k) for k in DOSE_STATUSES}
    bits = []
    if counts["taken"]:
        bits.append(trn("%d taken", "%d taken", counts["taken"]) % counts["taken"])
    if counts["skipped"]:
        bits.append(trn("%d skipped", "%d skipped", counts["skipped"]) % counts["skipped"])
    missed = sum(1 for d in doses if d[2] == "pending" and dose_missed(d))
    upcoming = counts["pending"] - missed
    if missed:
        bits.append(trn("%d not taken", "%d not taken", missed) % missed)
    if upcoming:
        bits.append(trn("%d yet to take", "%d yet to take", upcoming) % upcoming)
    main = "taken" if counts["taken"] else ("skipped" if counts["skipped"] else "pending")

