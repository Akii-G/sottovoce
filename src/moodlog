def pick_language():
    wanted = os.environ.get("MOODLOG_LANG") or configured_language()
    if wanted == "auto":
        wanted = system_language()
    return wanted if wanted in dict(LANGUAGES) and wanted != "auto" else "en"


def po_paths(code):
    here = os.path.dirname(os.path.realpath(os.path.abspath(sys.argv[0] if __name__ == "__main__"
                                                            else __file__)))
    dirs = [os.environ.get("MOODLOG_PO_DIR"), getattr(sys, "_MEIPASS", None) and os.path.join(sys._MEIPASS, "po"),
            os.path.join(here, "..", "po"),
            os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "po"),
            "/usr/share/moodlog/po"]
    return [os.path.join(d, code + ".po") for d in dirs if d]


def read_po(path):
    """A gettext .po file -> {msgid: text, (msgid, msgid_plural): [forms]}. Fuzzy entries are skipped."""
    catalog, entries = {}, []
    entry, key, fuzzy_next = None, None, False
    with open(path, encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if line.startswith("#"):
                fuzzy_next = fuzzy_next or (line.startswith("#,") and "fuzzy" in line)
                continue
            if line.startswith('"'):
                if entry is not None and key:
                    entry[key] += json.loads(line)
                continue
            name, _sep, rest = line.partition(" ")
            if not name:
                continue
            if name == "msgid":
                entry = {"fuzzy": fuzzy_next}
                fuzzy_next = False
                entries.append(entry)
            if entry is not None:
                key = name
                entry[key] = json.loads(rest.strip())
    for e in entries:
        msgid = e.get("msgid")
        if not msgid or e["fuzzy"]:
            continue
        if "msgid_plural" in e:
            forms = [e.get("msgstr[0]", ""), e.get("msgstr[1]", "")]
            if all(forms):
                catalog[(msgid, e["msgid_plural"])] = forms
        elif e.get("msgstr"):
            catalog[msgid] = e["msgstr"]
    return catalog


LANG_CODE = pick_language()
CATALOG = {}
if LANG_CODE != "en":
    for _path in po_paths(LANG_CODE):
        if os.path.exists(_path):
            try:
                CATALOG = read_po(_path)
            except (OSError, ValueError):
                CATALOG = {}
            break


def tr(text):
    return CATALOG.get(text) or text


def trn(singular, plural, n):
    """The right form for a count; both English and Italian use one form for 1, another otherwise."""
    forms = CATALOG.get((singular, plural))
    if forms:
        return forms[0] if n == 1 else forms[1]
    return singular if n == 1 else plural


def fmt_date(day, pattern):
    """strftime with the app's own day and month names, so dates follow the app's language."""
    names = {"%A": WEEKDAYS_LONG[day.weekday()], "%a": WEEKDAYS[day.weekday()],
             "%B": MONTHS[day.month - 1], "%b": MONTHS_SHORT[day.month - 1]}
    if LANG_CODE == "it":   # Italian writes day and month names in lower case mid-sentence
        names = {k: v.lower() for k, v in names.items()}
    # "%-d" (day without a leading zero) is glibc only: Windows' C library crashes on it
    names["%-d"] = str(day.day)
    out = day.strftime(re.sub("%(?:[aAbB]|-d)", lambda m: names[m.group(0)].replace("%", "%%"), pattern))
    return out[:1].upper() + out[1:] if LANG_CODE == "it" else out


