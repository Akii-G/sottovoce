        self.text_view.grab_focus()

    def fail(self, message):
        self.error.set_text(message)
        self.error.set_visible(True)

    def on_save(self, *_):
        try:
            day = dt.date.fromisoformat(self.date_entry.get_text().strip())
        except ValueError:
            self.fail(tr("Write the date as year-month-day, for example %s.") % dt.date.today().isoformat())
            return
        feeling = ([""] + [k for k, _label in DREAM_FEELINGS])[self.feeling_drop.get_selected()]
        tags = clean_tags([k for k, btn in self.tag_buttons.items() if btn.get_active()])
        buf = self.text_view.get_buffer()
        text_ = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
        if not (feeling or tags or text_):
            self.fail(tr("Write a few words, or pick how it felt or a tag."))
            return
        private = self.private_check.get_active() and self.win.prefs["private_tick"]
        if self.dream:
            self.win.dreams.update(self.dream, day, feeling, tags, text_)
            if self.win.prefs["private_tick"]:
                self.win.dreams.set_private(self.dream, private)
        else:
            self.win.dreams.add(day, feeling, tags, text_, private=private)
        if self.win.save_dreams():
            self.close()
        else:
            self.fail(tr("Could not save the dream to dreams.csv."))

    def on_delete(self, *_):
        self.win.dreams.remove(self.dream)
        if self.win.save_dreams():
            self.close()
        else:
            self.fail(tr("Could not save the change to dreams.csv."))


def dream_summary_text(store, dreams, start=None, end=None):
    """Plain-language summary of the dreams in a period (None if there are none)."""
    st = dream_stats(store, dreams, start, end)
    if not st["nights"]:
        return None
    parts = [trn("%d night with a dream entry", "%d nights with a dream entry", st["nights"]) % st["nights"]]
    if st["nightmares"]:
        parts.append(trn("%d with a nightmare or a disturbing dream",
                         "%d with a nightmare or a disturbing dream", st["nightmares"]) % st["nightmares"])
    if st["pleasant"]:
        parts.append(trn("%d pleasant one", "%d pleasant ones", st["pleasant"]) % st["pleasant"])
    out = ", ".join(parts) + "."
    (bad, nbad), (other, nother) = st["after_bad"], st["after_other"]
    if nbad >= 3 and nother >= 3:
        out += " " + tr("Your mood on days after a disturbing dream: %.1f; after other dreams: %.1f. "
                        "This shows a pattern in your data, not a cause.") % (bad, other)
    return out


