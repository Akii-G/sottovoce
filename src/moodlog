REPORT_INK = {"ink": "#1b1b1b", "ink2": "#4a4945", "muted": "#6d6b66", "grid": "#e3e2dc",
              "axis": "#c3c2b7", "tile": "#f4f3ef", "surface": "#ffffff", "health": "#1baf7a",
              "energy": "#b87c10", "anxiety": "#7b5ad6", "moods": MOOD_COLORS_LIGHT}


class _Pdf:
    """A4 pages drawn with cairo, text laid out by Pango at print resolution."""

    W, H, M = 595.28, 841.89, 42.0

    def __init__(self, path):
        import cairo
        self.surface = cairo.PDFSurface(path, self.W, self.H)
        try:
            self.surface.set_metadata(cairo.PDF_METADATA_TITLE, tr("Mood report"))
            self.surface.set_metadata(cairo.PDF_METADATA_CREATOR, "Sottovoce " + VERSION)
        except (AttributeError, Exception):
            pass
        self.cr = cairo.Context(self.surface)
        self.ctx = PangoCairo.create_context(self.cr)
        PangoCairo.context_set_resolution(self.ctx, 72)
        self.page = 1
        self.y = self.M
        self.bottom = self.H - self.M - 18

    def text(self, s, x, y, size=9, color="#1b1b1b", bold=False, width=None, align=0,
             measure=False, italic=False):
        layout = Pango.Layout.new(self.ctx)
        desc = Pango.FontDescription.from_string("Sans")
        desc.set_size(int(size * Pango.SCALE))
        if bold:
            desc.set_weight(Pango.Weight.BOLD)
        if italic:
            desc.set_style(Pango.Style.ITALIC)
        layout.set_font_description(desc)
        if width:
            layout.set_width(int(width * Pango.SCALE))
            layout.set_wrap(Pango.WrapMode.WORD_CHAR)
            layout.set_alignment((Pango.Alignment.LEFT, Pango.Alignment.CENTER,
                                  Pango.Alignment.RIGHT)[align])
        layout.set_text(s, -1)
        w, h = layout.get_pixel_size()
        if not measure:
            if not width and align:
                x -= w * (0.5 if align == 1 else 1.0)
            src(self.cr, color)
            self.cr.move_to(x, y)
            PangoCairo.show_layout(self.cr, layout)
        return w, h

    def footer(self):
        y = self.H - self.M + 4
        self.text(tr("Made with Sottovoce · self-reported data, not a medical record"), self.M, y,
                  7.5, REPORT_INK["muted"])
        self.text(tr("Page %d") % self.page, self.W - self.M, y, 7.5, REPORT_INK["muted"], align=2)

    def new_page(self):
        self.footer()
        self.cr.show_page()
        self.page += 1
        self.y = self.M

    def ensure(self, height):
        if self.y + height > self.bottom:
            self.new_page()
            return True
        return False

    def finish(self):
        self.footer()
        self.surface.finish()


class _BookPdf(_Pdf):
    """The same A4 pages, with a quiet footer: a diary isn't a medical report."""

    def footer(self):
        if self.page > 1:
            self.text("%d" % self.page, self.W / 2, self.H - self.M + 4, 8, REPORT_INK["muted"], align=1)


BOOK_PERIODS = [("all", tr("All of it")), ("year", tr("This year")), ("12m", tr("The last 12 months")),
                ("3m", tr("The last 3 months"))]


def book_range(store, period, today=None):
    """(start, end) of a book period; start None means from the first day."""
    today = today or dt.date.today()
    start = {"year": dt.date(today.year, 1, 1), "12m": today - dt.timedelta(days=364),
             "3m": today - dt.timedelta(days=90)}.get(period)
    return start, today


def book_days(store, events, start=None, end=None, include_private=False):
    """[(day, [entries with something written or tagged], [events])], oldest first: the pages of
    the book. Entries with only a face and nothing written are left out, so it reads as a diary."""
    out = []
    days = set(store.days) | {e[0] for e in events.items}
    for day in sorted(days):
        if (start and day < start) or (end and day > end):
            continue
        entries = [e for e in store.entries(day)
                   if (include_private or not is_private(e, 7))
                   and (e[2].strip() or entry_feelings(e) or entry_activities(e))]
        evs = [e for e in events.items if e[0] == day]
        if entries or evs:
            out.append((day, entries, evs))
    return out


def _cap(text):
    return text[:1].upper() + text[1:]


def export_book(path, store, events, start=None, end=None, include_private=False):
    """Your notes as a book: month by month, each day with its moods, words and events.
    Returns the number of days in it (0 writes nothing)."""
    pages = book_days(store, events, start, end, include_private)
    if not pages:
        return 0
    ink = REPORT_INK
    pdf = _BookPdf(path)
    try:
        pdf.surface.set_metadata(__import__("cairo").PDF_METADATA_TITLE, tr("My diary"))
    except Exception:
        pass
    cr, M, W = pdf.cr, pdf.M, pdf.W
    first, last = pages[0][0], pages[-1][0]

    # ---- title page
    pdf.y = 300
    pdf.text(tr("My diary"), W / 2, pdf.y, 30, ink["ink"], bold=True, align=1)
    pdf.y += 50
    span = (_cap(fmt_date(first, "%B %Y")) if (first.year, first.month) == (last.year, last.month)
            else "%s – %s" % (_cap(fmt_date(first, "%B %Y")), fmt_date(last, "%B %Y")))
    pdf.text(span, W / 2, pdf.y, 13, ink["ink2"], align=1)
    pdf.y += 26
    pdf.text(trn("%d day", "%d days", len(pages)) % len(pages), W / 2, pdf.y, 10, ink["muted"], align=1)
    pdf.text(tr("Written sottovoce, made with Sottovoce"), W / 2, pdf.H - 120, 9, ink["muted"], align=1)
    pdf.new_page()

    month = None
    for day, entries, evs in pages:
        if (day.year, day.month) != month:
            if month is not None:
                pdf.new_page()
            month = (day.year, day.month)
            pdf.text(_cap(fmt_date(day, "%B %Y")), M, pdf.y, 22, ink["ink"], bold=True)
            pdf.y += 34
            cr.rectangle(M, pdf.y, W - 2 * M, 0.8)
            src(cr, ink["grid"])
            cr.fill()
            pdf.y += 16
        # keep a day's heading with at least its first lines
        pdf.ensure(60)
        moods = [e[1] for e in store.entries(day) if e[1] and (include_private or not is_private(e, 7))]
        avg = sum(moods) / len(moods) if moods else 0
        if avg:
            cr.new_path()
            cr.arc(M + 5, pdf.y + 7.5, 5, 0, 2 * math.pi)
            src(cr, ink["moods"][to_level(avg)])
            cr.fill()
        pdf.text(_cap(fmt_date(day, tr("%A %-d %B"))), M + 16, pdf.y, 12, ink["ink"], bold=True)
        pdf.y += 22
        for ev in evs:
            line = "%s · %s" % (EVENT_LABELS.get(ev[1], ""), ev[2]) + (" — " + ev[3].strip() if ev[3].strip() else "")
            _w, h = pdf.text(line, M + 16, 0, 9.5, measure=True, width=W - 2 * M - 16, italic=True)
            pdf.ensure(h + 6)
            pdf.text(line, M + 16, pdf.y, 9.5, ink["ink2"], width=W - 2 * M - 16, italic=True)
            pdf.y += h + 6
        for e in entries:
            head = " · ".join(p for p in (e[0], MOOD_NAMES[e[1]] if e[1] else "") if p)
            words = " · ".join(p for p in (feelings_text(entry_feelings(e)), activities_text(entry_activities(e))) if p)
            if head:
                pdf.ensure(18)
                tx = M + 16
                if e[1]:
                    cr.new_path()
                    draw_face(cr, M + 22, pdf.y + 6.5, 6, e[1], ink["moods"][e[1]])
                    cr.new_path()
                    tx = M + 34
                pdf.text(head, tx, pdf.y + 0.5, 8.5, ink["muted"])
                pdf.y += 17
            if e[2].strip():
                for para in [p.strip() for p in e[2].strip().split("\n") if p.strip()]:
                    _w, h = pdf.text(para, M + 16, 0, 10.5, measure=True, width=W - 2 * M - 16)
                    pdf.ensure(h + 4)
                    pdf.text(para, M + 16, pdf.y, 10.5, ink["ink"], width=W - 2 * M - 16)
                    pdf.y += h + 4
            if words:
                _w, h = pdf.text(words, M + 16, 0, 8.5, measure=True, width=W - 2 * M - 16)
                pdf.ensure(h + 4)
                pdf.text(words, M + 16, pdf.y, 8.5, ink["muted"], width=W - 2 * M - 16)
                pdf.y += h + 4
            pdf.y += 8
        pdf.y += 10
    pdf.finish()
    return len(pages)


def _avg(values):
    values = [v for v in values if v]
    return sum(values) / len(values) if values else 0.0


def export_report(path, store, events, health, start, end, include_notes=False,
                  include_health=True, dreams=None, dream_mode="off", meds=None, surveys=None,
                  points=None):
    """A printable summary for a doctor or therapist. Returns the number of pages.

    dream_mode: "off" (default: dreams are private), "summary" (counts, nightmare nights
    marked in the day-by-day table) or "text" (also what each dream was about)."""
    if not dreams or dream_mode not in ("summary", "text"):
        dreams, dream_mode = DreamStore(""), "off"
    ink = REPORT_INK
    pdf = _Pdf(path)
    cr, M, W = pdf.cr, pdf.M, pdf.W
    span = (end - start).days + 1
    days = [start + dt.timedelta(days=i) for i in range(span)]
    mood_days = [d for d in days if store.day_avg(d)]
    entries = [m for d, _t, m in store.timed(start, end)]
    evs = events.between(start, end)
    number = {id(e): i + 1 for i, e in enumerate(evs)}
    sleep = health.values.get("sleep_hours", {}) if include_health else {}
    rhr = health.values.get("resting_hr", {}) if include_health else {}
    steps = health.values.get("steps", {}) if include_health else {}
    sleep_days = [d for d in days if d in sleep]

    # ---- title
    pdf.text(tr("Mood report"), M, pdf.y, 20, ink["ink"], bold=True)
    pdf.y += 30
    sub = tr("%s – %s · %d days · made with Sottovoce on %s") % (
        fmt_date(start, "%-d %B %Y"), fmt_date(end, "%-d %B %Y"), span,
        fmt_date(dt.date.today(), "%-d %B %Y"))
    pdf.text(sub, M, pdf.y, 9, ink["muted"])
    pdf.y += 24

    # ---- things to talk about (only when chosen in the report options)
    if points:
        pdf.text(tr("Things I want to talk about"), M, pdf.y, 12, ink["ink"], bold=True)
        pdf.y += 20
        for point in points:
            _w, h = pdf.text(point["text"], M + 14, 0, 10, measure=True, width=W - 2 * M - 14)
            pdf.ensure(h + 6)
            pdf.text("\u2022", M + 2, pdf.y, 10, ink["ink"])
            pdf.text(point["text"], M + 14, pdf.y, 10, ink["ink"], width=W - 2 * M - 14)
            pdf.y += h + 6
        pdf.y += 14

    # ---- key numbers
    avg_mood = _avg(store.day_avg(d) for d in mood_days)
    tiles = [(tr("Days with a mood"), tr("%d of %d") % (len(mood_days), span), None),
             (tr("Average mood (1–5)"), ("%.1f  %s" % (avg_mood, MOOD_NAMES[to_level(avg_mood)]))
              if avg_mood else "–", to_level(avg_mood) if avg_mood else None),
             (tr("Moods logged"), str(len(entries)), None)]
    for index, key, name, _hint in SCALES:
        value = _avg(store.day_scale(d, index) for d in days)
        tiles.append(({"energy": tr("Average energy (1–5)"),
                    "anxiety": tr("Average anxiety (1–5)")}[key],
                      ("%.1f  %s" % (value, SCALE_WORDS[key][to_level(value)])) if value else "–",
                      None))
    if sleep_days:
        tiles.append((tr("Average sleep"), tr("%.1f h  (%d nights)") % (_avg(sleep[d] for d in sleep_days),
                                                             len(sleep_days)), None))
    elif rhr:
        vals = [rhr[d] for d in days if d in rhr]
        if vals:
            tiles.append((tr("Resting heart rate"), tr("%.0f bpm") % _avg(vals), None))
    cols, gap, th = 3, 10, 50
    tw = (W - 2 * M - gap * (cols - 1)) / cols
    for i, (label, value, level) in enumerate(tiles):
        r, c = divmod(i, cols)
        x, y = M + c * (tw + gap), pdf.y + r * (th + gap)
        rounded_rect(cr, x, y, tw, th, 6)
        src(cr, ink["tile"])
        cr.fill()
        if level:
            rounded_rect(cr, x, y, 5, th, 2)
            src(cr, ink["moods"][level])
            cr.fill()
        pdf.text(label, x + 12, y + 8, 8, ink["muted"])
        pdf.text(value, x + 12, y + 22, 13, ink["ink"], bold=True)
    pdf.y += ((len(tiles) + cols - 1) // cols) * (th + gap) + 8

    # ---- mood mix (one stacked bar)
    if entries:
        pdf.text(tr("How often each mood was logged"), M, pdf.y, 10, ink["ink"], bold=True)
        pdf.y += 17
        total, x, bw, bh = len(entries), M, W - 2 * M, 14
        for level in range(1, 6):
            n = entries.count(level)
            if not n:
                continue
            seg = bw * n / total
            cr.rectangle(x, pdf.y, max(seg - 2, 1), bh)
            src(cr, ink["moods"][level])
            cr.fill()
            x += seg
        pdf.y += bh + 6
        x = M
        for level in range(1, 6):
            n = entries.count(level)
            cr.rectangle(x, pdf.y + 2, 8, 8)
            src(cr, ink["moods"][level])
            cr.fill()
            w, _h = pdf.text("%s %d%%" % (MOOD_NAMES[level], round(100 * n / total)), x + 12, pdf.y,
                             8.5, ink["ink2"])
            x += w + 26
        pdf.y += 22

    # ---- feeling words (not from private entries)
    words = feeling_counts(store, start, end)
    if words:
        line = tr("Feeling words picked most often: %s.") % ", ".join(
            "%s (%d)" % (FEELING_LABELS[k], n) for k, n in words[:8])
        _w, h = pdf.text(line, M, 0, 9, measure=True, width=W - 2 * M)
        pdf.text(line, M, pdf.y, 9, ink["ink2"], width=W - 2 * M)
        pdf.y += h + 16
    did = activity_counts(store, start, end)
    if did:
        line = tr("Activities logged most often: %s.") % ", ".join(
            "%s (%d)" % (ACTIVITY_LABELS[k], n) for k, n in did[:8])
        _w, h = pdf.text(line, M, 0, 9, measure=True, width=W - 2 * M)
        pdf.text(line, M, pdf.y, 9, ink["ink2"], width=W - 2 * M)
        pdf.y += h + 16

    # ---- time charts
    weekly = span > 120

    def buckets(values):
        """{day: value} -> [(x position 0..1, value, label)] daily, or weekly averages."""
        out = []
        if not weekly:
            for i, d in enumerate(days):
                if d in values:
                    out.append((i, values[d], fmt_date(d, "%-d %b")))
            return out, span
        weeks = {}
        for d, v in values.items():
            if start <= d <= end:
                weeks.setdefault((d - start).days // 7, []).append(v)
        return [(w, sum(v) / len(v), "") for w, v in sorted(weeks.items())], (span + 6) // 7

    def xpos(i, n, left, width):
        return left + (width / 2 if n <= 1 else 6 + i / (n - 1) * (width - 12))

    def axis_ticks(n, left, width, top, height):
        """Month or week tick labels under a chart, and the event lines with numbers."""
        cr.set_line_width(0.6)
        for i, d in enumerate(days):
            first = d.day == 1 or i == 0
            if span <= 45:
                show = d.weekday() == 0 or i == 0
                label = fmt_date(d, "%-d %b")
            else:
                show = first
                label = fmt_date(d, "%b %Y" if d.month == 1 or i == 0 else "%b")
            if show:
                slot = i if not weekly else i // 7
                x = xpos(slot, n, left, width)
                pdf.text(label, x, top + height + 4, 7.5, ink["muted"], align=1)
        for e in evs:
            i = (e[0] - start).days
            slot = i if not weekly else i // 7
            x = round(xpos(slot, n, left, width)) + 0.5
            src(cr, ink["ink2"], 0.7)
            cr.set_line_width(0.8)
            cr.set_dash([2.5, 2.5])
            cr.move_to(x, top)
            cr.line_to(x, top + height)
            cr.stroke()
            cr.set_dash([])
            src(cr, ink["ink"])
            cr.arc(x, top - 6, 5.5, 0, 2 * math.pi)
            cr.fill()
            pdf.text(str(number[id(e)]), x, top - 11, 6.5, "#ffffff", bold=True, align=1)

    def chart_frame(title, legend=None, height=118, note=None):
        need = height + 52
        pdf.ensure(need)
        pdf.text(title, M, pdf.y, 10, ink["ink"], bold=True)
        if legend:
            x = W - M
            for name, color in reversed(legend):
                w, _h = pdf.text(name, x, pdf.y + 1, 8, ink["ink2"], align=2)
                src(cr, color)
                cr.set_line_width(2)
                cr.move_to(x - w - 18, pdf.y + 6)
                cr.line_to(x - w - 5, pdf.y + 6)
                cr.stroke()
                x -= w + 30
        top = pdf.y + 26
        pdf.y = top + height + 20
        if note:
            pdf.text(note, M, pdf.y - 4, 7.5, ink["muted"], italic=True)
            pdf.y += 10
        pdf.y += 10
        return top, height

    left, width = M + 44, W - 2 * M - 44
    if mood_days:
        top, height = chart_frame(tr("Mood, %s") % (tr("weekly average") if weekly else tr("daily average")),
                                  note=(tr("Numbered marks are the events listed below.")
                                        if evs else None))
        for level in range(1, 6):
            y = round(top + height - (level - 1) / 4 * height) + 0.5
            src(cr, ink["grid"])
            cr.set_line_width(0.6)
            cr.move_to(left, y)
            cr.line_to(left + width, y)
            cr.stroke()
            pdf.text(MOOD_NAMES[level], left - 8, y - 5, 7.5, ink["muted"], align=2)
        pts, n = buckets({d: store.day_avg(d) for d in mood_days})
        src(cr, ink["ink2"])
        cr.set_line_width(1.3)
        prev = None
        for i, v, _l in pts:
            x, y = xpos(i, n, left, width), top + height - (v - 1) / 4 * height
            if prev is not None and i - prev == 1:
                cr.line_to(x, y)
            else:
                cr.stroke()
                cr.move_to(x, y)
            prev = i
        cr.stroke()
        for i, v, _l in pts:
            x, y = xpos(i, n, left, width), top + height - (v - 1) / 4 * height
            src(cr, ink["surface"])
            cr.arc(x, y, 3.2, 0, 2 * math.pi)
            cr.fill()
            src(cr, ink["moods"][to_level(v)])
            cr.arc(x, y, 2.3, 0, 2 * math.pi)
            cr.fill()
        axis_ticks(n, left, width, top, height)

    scale_values = {key: {d: store.day_scale(d, index) for d in days if store.day_scale(d, index)}
                    for index, key, _n, _h in SCALES}
    if any(scale_values.values()):
        top, height = chart_frame(
            tr("Energy and anxiety (1–5)"), legend=[(name, ink[key]) for _i, key, name, _h in SCALES],
            height=96, note=tr("Energy: 1 very low, 5 very high. Anxiety: 1 calm, 5 very anxious."))
        for level in range(1, 6):
            y = round(top + height - (level - 1) / 4 * height) + 0.5
            src(cr, ink["grid"])
            cr.set_line_width(0.6)
            cr.move_to(left, y)
            cr.line_to(left + width, y)
            cr.stroke()
            pdf.text(str(level), left - 8, y - 5, 7.5, ink["muted"], align=2)
        for _index, key, _name, _hint in SCALES:
            pts, n = buckets(scale_values[key])
            src(cr, ink[key])
            cr.set_line_width(1.4)
            prev = None
            for i, v, _l in pts:
                x, y = xpos(i, n, left, width), top + height - (v - 1) / 4 * height
                if prev is not None and i - prev == 1:
                    cr.line_to(x, y)
                else:
                    cr.stroke()
                    cr.move_to(x, y)
                prev = i
            cr.stroke()
            for i, v, _l in pts:
                cr.arc(xpos(i, n, left, width), top + height - (v - 1) / 4 * height, 1.8, 0, 2 * math.pi)
                cr.fill()
        n = span if not weekly else (span + 6) // 7
        axis_ticks(n, left, width, top, height)

    if sleep_days:
        top, height = chart_frame(tr("Sleep (hours a night%s)") % (tr(", weekly average") if weekly else ""),
                                  height=86)
        pts, n = buckets({d: sleep[d] for d in sleep_days})
        hi = max(10, math.ceil(max(v for _i, v, _l in pts) / 2) * 2)
        for tick in range(0, hi + 1, 2 if hi <= 12 else 4):
            y = round(top + height - tick / hi * height) + 0.5
            src(cr, ink["axis"] if tick == 0 else ink["grid"])
            cr.set_line_width(0.6)
            cr.move_to(left, y)
            cr.line_to(left + width, y)
            cr.stroke()
            pdf.text(str(tick), left - 8, y - 5, 7.5, ink["muted"], align=2)
        bw = max(1.5, min(10, (width - 12) / max(n, 1) - 1.5))
        for i, v, _l in pts:
            x, bh = xpos(i, n, left, width), v / hi * height
            bar_up(cr, x - bw / 2, top + height - bh, bw, bh, r=min(2, bw / 2))
            src(cr, ink["health"])
            cr.fill()
        axis_ticks(n, left, width, top, height)

    # ---- events
    if evs:
        pdf.ensure(70)
        pdf.text(tr("Events"), M, pdf.y, 12, ink["ink"], bold=True)
        pdf.y += 22
        weeks = AROUND_DAYS // 7
        colx = [M, M + 22, M + 92, M + 190, M + 410, M + 466]
        heads = ["#", tr("Date"), tr("Type"), tr("What happened"),
                 tr("Mood %dw before") % weeks, tr("Mood %dw after") % weeks]

        def event_head():
            for x, h in zip(colx, heads):
                pdf.text(h, x, pdf.y, 7.5, ink["muted"], bold=True,
                         width=50 if x >= colx[4] else None)
            pdf.y += 22
            src(cr, ink["axis"])
            cr.set_line_width(0.6)
            cr.move_to(M, pdf.y - 4)
            cr.line_to(W - M, pdf.y - 4)
            cr.stroke()
        event_head()
        for e in evs:
            day, kind, title, note = e[:4]
            what = title + (("\n" + note.strip()) if note.strip() else "")
            _w, h = pdf.text(what, colx[3], 0, 8.5, measure=True, width=210)
            if pdf.ensure(h + 10):
                event_head()
            y = pdf.y
            pdf.text(str(number[id(e)]), colx[0], y, 8.5, ink["ink"], bold=True)
            pdf.text(fmt_date(day, "%-d %b %Y"), colx[1], y, 8.5, ink["ink"])
            pdf.text(EVENT_LABELS[kind], colx[2], y, 8.5, ink["ink"], width=95)
            pdf.text(what, colx[3], y, 8.5, ink["ink"], width=210)
            if day <= dt.date.today():
                (b, nb), (a, na), complete = mood_around(store, day)
                for x, (v, cnt) in ((colx[4], (b, nb)), (colx[5], (a, na))):
                    if cnt >= 3:
                        cr.rectangle(x, y + 2, 7, 7)
                        src(cr, ink["moods"][to_level(v)])
                        cr.fill()
                        pdf.text("%.1f (%d d)" % (v, cnt), x + 10, y, 8.5, ink["ink"])
                    else:
                        pdf.text("–", x + 10, y, 8.5, ink["muted"])
                if not complete:
                    pdf.text(tr("so far"), colx[5] + 10, y + 11, 7, ink["muted"], italic=True)
            pdf.y += max(h, 22) + 6
            src(cr, ink["grid"])
            cr.set_line_width(0.5)
            cr.move_to(M, pdf.y - 3)
            cr.line_to(W - M, pdf.y - 3)
            cr.stroke()
        pdf.y += 12

    # ---- medication (from Dose and Apple Health): current ones, then the ones no longer taken
    med_rows = meds.summary(start, end) if meds else []
    if med_rows:
        current = [r for r in med_rows if not meds.meds.get(r[0], {}).get("archived")]
        previous = [r for r in med_rows if meds.meds.get(r[0], {}).get("archived")]
        sources = meds.sources() if hasattr(meds, "sources") else ["health"]
        note = {("dose",): tr("As marked in Dose."), ("health",): tr("As logged in Apple Health."),
                }.get(tuple(sources), tr("As marked in Dose and logged in Apple Health."))
        note += " " + tr("Not taken: doses that were due and never marked. Yet to take: due later today.")
        colx = [M, M + 182, M + 232, M + 282, M + 334, M + 390, M + 452]
        heads = [tr("Medication"), tr("Taken"), tr("Skipped"), tr("Not taken"), tr("Yet to take"),
                 tr("First in period"), tr("Last in period")]

        def med_head():
            for x, h_ in zip(colx, heads):
                pdf.text(h_, x, pdf.y, 7.5, ink["muted"], bold=True, width=58 if x > colx[0] else None)
            pdf.y += 22
            src(cr, ink["axis"])
            cr.set_line_width(0.6)
            cr.move_to(M, pdf.y - 3)
            cr.line_to(W - M, pdf.y - 3)
            cr.stroke()

        for title, rows in ((tr("Medication"), current), (tr("Previous medication"), previous)):
            if not rows:
                continue
            pdf.ensure(80)
            pdf.text(title, M, pdf.y, 12, ink["ink"], bold=True)
            pdf.y += 20
            if rows is current or not current:
                _w, h = pdf.text(note, M, 0, 8, measure=True, width=W - 2 * M)
                pdf.text(note, M, pdf.y, 8, ink["muted"], width=W - 2 * M)
                pdf.y += h + 8
            med_head()
            for name, taken, skipped, missed, upcoming, first, last in rows:
                info = meds.meds.get(name, {})
                label = name + (" · " + tr("as needed") if info.get("as_needed") else "")
                _w, h = pdf.text(label, colx[0], 0, 8.5, measure=True, width=172)
                if pdf.ensure(h + 8):
                    med_head()
                y = pdf.y
                pdf.text(label, colx[0], y, 8.5, ink["ink"], width=172)
                for x, n in zip(colx[1:5], (taken, skipped, missed, upcoming)):
                    pdf.text(str(n) if n else "–", x, y, 8.5, ink["ink"] if n else ink["muted"])
                pdf.text(fmt_date(first, "%-d %b %Y"), colx[5], y, 8.5, ink["ink"])
                pdf.text(fmt_date(last, "%-d %b %Y"), colx[6], y, 8.5, ink["ink"])
                pdf.y += max(h, 12) + 6
            pdf.y += 10

    # ---- questionnaires (PHQ-9, GAD-7)
    taken = [x for x in surveys.between(start, end) if not x.get("private")] if surveys else []
    if taken:
        pdf.ensure(90)
        pdf.text(tr("Questionnaires"), M, pdf.y, 12, ink["ink"], bold=True)
        pdf.y += 20
        note = tr("Answered in Sottovoce. Each answer counts 0 (not at all) to 3 (nearly every day); "
                  "the score is their sum, out of 27 for PHQ-9 and 21 for GAD-7. The answers are "
                  "listed in question order. Sottovoce gives no interpretation.")
        _w, h = pdf.text(note, M, 0, 8, measure=True, width=W - 2 * M)
        pdf.text(note, M, pdf.y, 8, ink["muted"], width=W - 2 * M)
        pdf.y += h + 8
        colx = [M, M + 110, M + 180, M + 240, M + 370]
        heads = [tr("Date"), tr("Questionnaire"), tr("Score"), tr("Answers"), tr("Difficulty")]

        def survey_head():
            for x, h_ in zip(colx, heads):
                pdf.text(h_, x, pdf.y, 7.5, ink["muted"], bold=True)
            pdf.y += 14
            src(cr, ink["axis"])
            cr.set_line_width(0.6)
            cr.move_to(M, pdf.y - 3)
            cr.line_to(W - M, pdf.y - 3)
            cr.stroke()
        survey_head()
        diff_words = survey_text()["difficulty_options"]
        for x in taken:
            diff = diff_words[x["difficulty"]] if x["difficulty"] >= 0 else "–"
            _w, h = pdf.text(diff, colx[4], 0, 8.5, measure=True, width=W - M - colx[4])
            if pdf.ensure(h + 8):
                survey_head()
            y = pdf.y
            pdf.text(fmt_date(x["date"], "%-d %b %Y"), colx[0], y, 8.5, ink["ink"])
            pdf.text(survey_name(x["kind"]), colx[1], y, 8.5, ink["ink"])
            pdf.text("%d / %d" % (survey_score(x), survey_max(x["kind"])), colx[2], y, 8.5, ink["ink"],
                     bold=True)
            pdf.text(" ".join(str(a) for a in x["answers"]), colx[3], y, 8.5, ink["ink"])
            pdf.text(diff, colx[4], y, 8.5, ink["ink"], width=W - M - colx[4])
            pdf.y += max(h, 12) + 6
        credit = survey_text()["credit"]
        _w, h = pdf.text(credit, M, 0, 7, measure=True, width=W - 2 * M)
        pdf.ensure(h + 6)
        pdf.text(credit, M, pdf.y + 2, 7, ink["muted"], width=W - 2 * M, italic=True)
        pdf.y += h + 16

    # ---- dreams
    dream_text = dream_summary_text(store, dreams, start, end) if dream_mode != "off" else None
    if dream_text:
        pdf.ensure(70)
        pdf.text(tr("Dreams"), M, pdf.y, 12, ink["ink"], bold=True)
        pdf.y += 22
        _w, h = pdf.text(dream_text, M, 0, 9, measure=True, width=W - 2 * M)
        pdf.text(dream_text, M, pdf.y, 9, ink["ink2"], width=W - 2 * M)
        pdf.y += h + 18

    # ---- day by day
    show_dreams = dream_mode != "off" and bool(dreams.between(start, end))
    rows = [d for d in days if store.entries(d) or events.on(d) or (include_health and d in sleep)
            or (show_dreams and dreams.on(d))]
    if rows:
        pdf.ensure(80)
        pdf.text(tr("Day by day"), M, pdf.y, 12, ink["ink"], bold=True)
        pdf.y += 22
        has_sleep = bool(sleep_days)
        cols = [(tr("Date"), 74), (tr("Mood"), 92), (tr("Energy"), 40), (tr("Anxiety"), 44)]
        if has_sleep:
            cols.append((tr("Sleep"), 38))
